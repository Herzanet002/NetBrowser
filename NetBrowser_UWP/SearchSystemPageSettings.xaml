<Page
    x:Class="NetBrowser_UWP.SearchSystemPageSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls" d:DataContext="{d:DesignInstance Type=local:SearchSystemPageSettings}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="150" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Text="Поисковая система" FontSize="40" Grid.Row="0"
                   Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" Margin="50,30,0,20"/>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="Выбор движка" FontSize="26" Grid.Row="1" 
                   Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" Margin="70,0,0,0" />
        
        <ComboBox Grid.Row="2" Margin="80,10,0,0" 
                  ItemsSource="{Binding ListOfEngines, UpdateSourceTrigger=PropertyChanged}"
                  MinWidth="250" DropDownClosed="comboboxSearchEngine_DropDownClosed" 
                  SelectedItem="{Binding CurrentEngine, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                  DisplayMemberPath="Name">
        </ComboBox>
       
        
    </Grid>
</Page>
