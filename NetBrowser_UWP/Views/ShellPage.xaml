<Page
    x:Class="NetBrowser_UWP.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:winUi="using:Microsoft.UI.Xaml.Controls" 
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:actions="using:NetBrowser_UWP.Commands"
    xmlns:models="using:NetBrowser_UWP.Models"
    xmlns:viewModels="using:NetBrowser_UWP.ViewModels"
    xmlns:converters="using:NetBrowser_UWP.Converters"
    xmlns:helpers="using:NetBrowser_UWP.Helpers"
    Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}"
    d:DataContext="{d:DesignInstance Type=viewModels:ShellPageViewModel,IsDesignTimeCreatable=True}"
    IsTabStop="True">

    <Grid>
        <Grid.Resources>
            <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
            <Style x:Name="NavigationBarButtonStyle" BasedOn="{StaticResource ButtonRevealStyle}" TargetType="Button">
                <Setter Property="Background" Value="Transparent"></Setter>
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="Padding" Value="0"></Setter>
                <Setter Property="Width" Value="34"></Setter>
                <Setter Property="Height" Value="30"></Setter>
                <Setter Property="BorderThickness" Value="1"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <PointerUpThemeAnimation Storyboard.TargetName="RootGrid"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.(RevealBrush.State)" Value="PointerOver"/>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource ButtonRevealBackgroundPointerOver}"/>
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ButtonRevealBorderBrushPointerOver}"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPointerOver}"/>
                                            </VisualState.Setters>
                                            <Storyboard>
                                                <PointerUpThemeAnimation Storyboard.TargetName="RootGrid"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.(RevealBrush.State)" Value="Pressed"/>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource ButtonRevealBackgroundPressed}"/>
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ButtonRevealBorderBrushPressed}"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPressed}"/>
                                            </VisualState.Setters>
                                            <Storyboard>
                                                <PointerDownThemeAnimation Storyboard.TargetName="RootGrid"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{x:Null}"/>
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ButtonRevealBorderBrushDisabled}"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundDisabled}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter" AutomationProperties.AccessibilityView="Raw"
                                                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" CornerRadius="{TemplateBinding CornerRadius}" 
                                                  Content="{TemplateBinding Content}" ContentTransitions="{TemplateBinding ContentTransitions}" 
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Padding="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}" Height="30">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <winUi:ProgressRing IsActive="{Binding IsProgressRingActive}" Height="10" Width="10"
                                    Foreground="{Binding AppTitleBrush, Source={StaticResource ThemeManager}}">
                </winUi:ProgressRing>
                <TextBlock
                       VerticalAlignment="Center" Margin="15,0" FontSize="12.5" HorizontalTextAlignment="Center"
                       Foreground="{Binding AppTitleBrush, Source={StaticResource ThemeManager}}">
                    <Run Text="{helpers:ResourceString Name=AppTitle/Text}"/>
                    <Run Text="{Binding AppTitleText}"/>
                </TextBlock>
            </StackPanel>
            
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Stretch" Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}"
              ColumnSpacing="5" Height="44" Padding="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="600*"/>
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!--Back Button-->
            <Button Grid.Column="0" Style="{StaticResource NavigationBarButtonStyle}" 
                    ToolTipService.ToolTip="{helpers:ResourceString Name=BackButton/Tooltip}" 
                    ToolTipService.Placement="Bottom" Command="{Binding BackButtonCommand}">
                <FontIcon Glyph="&#xF0D3;" FontSize="{StaticResource NavigationBarButtonFontSize}" />
            </Button>
            <!--Forward Button-->
            <Button Grid.Column="1" Command="{Binding ForwardButtonCommand}" Style="{StaticResource NavigationBarButtonStyle}"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=ForwardButton/Tooltip}" ToolTipService.Placement="Bottom">
                <FontIcon Glyph="&#xF0D2;" FontSize="{StaticResource NavigationBarButtonFontSize}" />
            </Button>

            <!--Refresh button-->
            <Button Grid.Column="2" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding ReloadButtonCommand}" 
                    ToolTipService.ToolTip="{helpers:ResourceString Name=RefreshButton/Tooltip}" ToolTipService.Placement="Bottom" Visibility="{Binding IsWebLoading, Converter={StaticResource InvertBooleanConverter}}">
                <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource NavigationBarButtonFontSize}"/>

            </Button>
            <!--Stop loading button-->
            <Button Grid.Column="2" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding StopLoadingButtonCommand}" 
                    ToolTipService.ToolTip="{helpers:ResourceString Name=StopLoadingButton/Tooltip}" ToolTipService.Placement="Bottom" Visibility="{Binding IsWebLoading}">
                <FontIcon Glyph="&#xE711;" FontSize="20"/>
            </Button>

            <!--Home button-->
            <Button Grid.Column="3" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding HomeButtonCommand}"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=HomeButton/Tooltip}" ToolTipService.Placement="Bottom" Visibility="{Binding VisibilityHomeButton}">
                <FontIcon Glyph="&#xE80F;" FontSize="{StaticResource NavigationBarButtonFontSize}"/>
            </Button>

            <!--SearchBox-->
            <AutoSuggestBox x:Name="SearchBox" Style="{StaticResource AutoSuggestBoxTemplate}" Grid.Column="4"
                            Text="{Binding SearchBoxText, Mode=TwoWay}" QueryIcon="Find"
                            ItemsSource="{Binding SearchBoxItemsCollection}" UpdateTextOnSelect="True"
                            PlaceholderText="{helpers:ResourceString Name=SearchBoxPlaceholder/PlaceholderText}">
                <AutoSuggestBox.Shadow>
                    <ThemeShadow/>
                </AutoSuggestBox.Shadow>

                <i:Interaction.Behaviors>
                    <core:EventTriggerBehavior EventName="TextChanged">
                        <core:InvokeCommandAction Command="{Binding SearchBoxTextChangedCommand}" />
                    </core:EventTriggerBehavior>
                    <core:EventTriggerBehavior EventName="QuerySubmitted">
                        <core:InvokeCommandAction Command="{Binding SearchBoxQuerySubmittedCommand}" />
                    </core:EventTriggerBehavior>
                </i:Interaction.Behaviors>
            </AutoSuggestBox>


            <Button Background="Transparent" HorizontalAlignment="Left" Margin="5,0,0,0"
                    Padding="0" Width="28" Height="24" BorderBrush="Transparent"  Grid.Column="4"
                    VerticalAlignment="Center" Command="{Binding AddBookmarkButtonCommand}"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=SaveBookmarkButton/Tooltip}" ToolTipService.Placement="Bottom">
                <i:Interaction.Behaviors>
                    <core:DataTriggerBehavior Binding="{Binding IsBookmarksExists}" Value="True" >
                        <core:DataTriggerBehavior.Actions>
                            <core:ChangePropertyAction
                                PropertyName="Content">
                                <core:ChangePropertyAction.Value>
                                    <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{Binding BookmarkSavedBrush, Source={StaticResource ThemeManager}}"></FontIcon>
                                </core:ChangePropertyAction.Value>
                            </core:ChangePropertyAction>
                        </core:DataTriggerBehavior.Actions>
                    </core:DataTriggerBehavior>
                    <core:DataTriggerBehavior Binding="{Binding IsBookmarksExists}" Value="False" >
                        <core:DataTriggerBehavior.Actions>
                            <core:ChangePropertyAction
                                PropertyName="Content">
                                <core:ChangePropertyAction.Value>
                                    <FontIcon Glyph="&#xE734;" FontSize="14"></FontIcon>
                                </core:ChangePropertyAction.Value>
                            </core:ChangePropertyAction>
                        </core:DataTriggerBehavior.Actions>
                    </core:DataTriggerBehavior>
                </i:Interaction.Behaviors>
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Orientation="Vertical" Width="300">
                            <TextBlock Text="Добавить закладку" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="14"
                                       Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" ></TextBlock>
                            <TextBox Text="{Binding BookmarkTitleForSave, Mode=TwoWay}"
                                     Header="Заголовок" Margin="0,15" PlaceholderText="Название сайта"></TextBox>
                            <TextBox Text="{Binding BookmarkUrlForSave, Mode=TwoWay}" Header="Ссылка"
                                     Margin="0,10,0,30" PlaceholderText="Ссылка на сайт"></TextBox>
                            <StackPanel Orientation="Horizontal" Spacing="30">
                                <Button Content="Отмена" Command="{Binding CancelSaveBookmarkButtonCommand}"></Button>
                                <Button Content="Удалить"
                                        Visibility="{Binding DeleteBookmarkButtonVisibility}" Command="{Binding DeleteBookmarkButtonCommand}"/>
                                <Button Content="Добавить" Command="{Binding SaveBookmarkButtonCommand}" 
                                        Visibility="{Binding DeleteBookmarkButtonVisibility, Converter={StaticResource InvertBooleanConverter}}"></Button>
                            </StackPanel>
                        </StackPanel>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button Grid.Column="6" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding NewsContentButtonCommand}">
                <FontIcon Glyph="&#xE8A1;" FontSize="{StaticResource NavigationBarButtonFontSize}"/>
            </Button>
            <!--Bookmarks Flyout-->
            <Button Grid.Column="7" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding BookmarksButtonCommand}"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=BookmarksButton/Tooltip}" ToolTipService.Placement="Bottom">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <Grid>
                            <StackPanel Width="300">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Сохраненные закладки" FontWeight="SemiBold" FontSize="16" Margin="0,10" HorizontalAlignment="Center"
                                               Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}"/>
                                    <Button Grid.Column="1" Width="32" Height="28" Padding="0" ToolTipService.ToolTip="Параметры закладок" 
                                            Command="{Binding BookmarksSettingsButtonCommand}">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                                    </Button>
                                </Grid>

                                <ListView MaxHeight="500" IsItemClickEnabled="True" ItemsSource="{Binding BookmarksList}" >
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:BookmarkDetails">
                                            <Grid Height="40">
                                                <StackPanel Orientation="Horizontal">
                                                    <BitmapIcon UriSource="{x:Bind FaviconUrl}"
                                                                ShowAsMonochrome="False" Width="18" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{x:Bind Name}" FontSize="14" 
                                                               HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <i:Interaction.Behaviors>
                                        <core:EventTriggerBehavior EventName="ItemClick">
                                            <core:InvokeCommandAction Command="{Binding BookmarksItemClickCommand}" />
                                        </core:EventTriggerBehavior>
                                    </i:Interaction.Behaviors>
                                </ListView>

                            </StackPanel>
                        </Grid>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE728;" FontSize="{StaticResource NavigationBarButtonFontSize}"/>
            </Button>

            <!--History Flyout-->
            <Button Grid.Column="8" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding HistoryButtonCommand}"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=HistoryButton/Tooltip}" ToolTipService.Placement="Bottom">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Width="320">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="История" FontWeight="SemiBold" Margin="0,10" HorizontalAlignment="Center"
                                           FontSize="16" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}"/>
                                <Button Grid.Column="1" Width="32" Height="28" Padding="0" ToolTipService.ToolTip="Параметры журнала истории" 
                                              Command="{Binding HistorySettingsButtonCommand}">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                                </Button>
                            </Grid>
                            <ListView MaxHeight="500" IsItemClickEnabled="True" 
                                      ItemsSource="{Binding HistoryList}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:HistoryItemDetails">
                                        <Grid Height="50" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Vertical" Margin="0,6,0,0">
                                                <TextBlock Text="{x:Bind Name}"  FontSize="14"
                                                HorizontalAlignment="Left" FontWeight="Bold"></TextBlock>
                                                <TextBlock Text="{x:Bind Url}" FontSize="11" 
                                                HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="14" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <i:Interaction.Behaviors>
                                    <core:EventTriggerBehavior EventName="ItemClick">
                                        <core:InvokeCommandAction Command="{Binding HistoryItemClickCommand}" />
                                    </core:EventTriggerBehavior>
                                </i:Interaction.Behaviors>
                            </ListView>
                        </StackPanel>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xF738;" FontSize="{StaticResource NavigationBarButtonFontSize}"/>
            </Button>


            <Rectangle Grid.Column="9" Width="1" Fill="{Binding SecondBrush, Source={StaticResource ThemeManager}}" 
                       Margin="10"/>

            <!--Settings button-->
            <Button Grid.Column="10" Style="{StaticResource NavigationBarButtonStyle}" 
                    ToolTipService.ToolTip="{helpers:ResourceString Name=SettingsButton/Tooltip}" ToolTipService.Placement="Bottom">
                <FontIcon Glyph="&#xE712;" FontSize="{StaticResource NavigationBarButtonFontSize}"/>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="{helpers:ResourceString Name=Settings}" Command="{Binding SettingsButtonCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="{helpers:ResourceString Name=TaskManager/Text}" Command="{Binding TaskManagerButtonCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7C4;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="{helpers:ResourceString Name=DeveloperInstruments/Text}" Command="{Binding DeveloperInstrumentsButtonCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEC7A;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

        </Grid>


        <Grid Grid.Row="2">
            <Grid.Resources>
                <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
            </Grid.Resources>
            <winUi:TabView TabItemsSource="{Binding TabViewItemsList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource TabViewStyleTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           SelectedItem="{Binding SelectedTabItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           AddTabButtonCommand="{Binding AddTabButtonCommand}"
                           Background="{Binding SecondBrush, Source={StaticResource ThemeManager}}">
                
                <!--<winUi:TabView.ContextFlyout>
                    <MenuFlyout x:Key="TabItemFlyout">
                        <MenuFlyoutItem Text="Новая вкладка" >
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE737;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Дублировать вкладку">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7C4;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Выключить звук на вкладке">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE74F;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Открыть только что закрытую вкладку">
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Закрыть вкладку">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE711;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </winUi:TabView.ContextFlyout>-->

                <i:Interaction.Behaviors>
                    <core:EventTriggerBehavior EventName="TabCloseRequested">
                        <core:InvokeCommandAction Command="{Binding CloseTabButtonCommand}"  />
                    </core:EventTriggerBehavior>
                </i:Interaction.Behaviors>

                <!--<KeyboardAccelerator Key="F11">
                    <i:Interaction.Behaviors>
                        <icore:EventTriggerBehavior EventName="Invoked">
                            <icore:InvokeCommandAction Command="{x:Bind ToggleFullScreenAcceleratorCommand}" />
                        </icore:EventTriggerBehavior>
                    </i:Interaction.Behaviors>
                </KeyboardAccelerator>-->
            </winUi:TabView>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding TabViewItemsList.Count, Converter={StaticResource IntToVisibilityConverter}}">
                <TextBlock Text="Нет открытых вкладок" VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="24"/>
                <TextBlock Text="Чтобы начать работу, создайте новую вкладку..." VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
            </StackPanel>
        </Grid>


    </Grid>

</Page>
