<views:NavigationViewContentPage
    x:Class="NetBrowser_UWP.Views.Settings.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:helpers="using:NetBrowser_UWP.Helpers"
    xmlns:settings="using:NetBrowser_UWP.Views.Settings"
    xmlns:views="using:NetBrowser_UWP.Views"
    Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}">

    <Grid>
        <muxc:NavigationView IsSettingsVisible="False"
                             PaneTitle="{helpers:ResourceString Name=Settings}"
                             IsBackEnabled="{x:Bind ViewModel.IsBackEnabled, Mode=OneWay}"
                             Canvas.ZIndex="0"
                             x:Name="SettingsNavigationView"
                             SelectedItem="{x:Bind ViewModel.Selected, Mode=OneWay}">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="{helpers:ResourceString Name=Settings/General}"
                                         helpers:NavigationHelper.NavigateTo="settings:MainItemPageSettings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74C;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="{helpers:ResourceString Name=Settings/History}"
                                         helpers:NavigationHelper.NavigateTo="settings:HistoryPageSettings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="{helpers:ResourceString Name=Settings/Personalization}"
                                         helpers:NavigationHelper.NavigateTo="settings:PersonalizePageSettings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE771;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="{helpers:ResourceString Name=Settings/SearchEngine}"
                                         helpers:NavigationHelper.NavigateTo="settings:SearchSystemPageSettings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE721;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

                <muxc:NavigationViewItem Content="{helpers:ResourceString Name=Settings/Favorites}"
                                         helpers:NavigationHelper.NavigateTo="settings:BookmarksPageSettings">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE728;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>

            </muxc:NavigationView.MenuItems>

            <muxc:NavigationView.FooterMenuItems>
                <muxc:NavigationViewItem Content="{helpers:ResourceString Name=Settings/About}"
                                         helpers:NavigationHelper.NavigateTo="settings:AboutAppPage">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.FooterMenuItems>
            <Grid>
                <Frame x:Name="ContentFrame" />
            </Grid>
        </muxc:NavigationView>

    </Grid>
</views:NavigationViewContentPage>