<Page
    x:Class="NetBrowser_UWP.Views.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:NetBrowser_UWP.ViewModels"
    xmlns:models="using:NetBrowser_UWP.Models"
    mc:Ignorable="d"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:resources="using:NetBrowser_UWP.Resources"
    xmlns:commands="using:NetBrowser_UWP.Commands"
    xmlns:converters="using:NetBrowser_UWP.Converters">
    <!--<interactivity:Interaction.Behaviors>
        <core:EventTriggerBehavior EventName="Loaded">
            <core:InvokeCommandAction Command="{Binding LoadedEventCommand}">
            </core:InvokeCommandAction>
        </core:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>-->


    <Page.DataContext>
        <viewModels:StartPageViewModel/>
    </Page.DataContext>

    <Page.Resources>
        <converters:TitleTextConverter x:Key="TitleTextConverter" />
        <converters:TitleLetterConverter x:Key="TitleLetterConverter" />
        <StandardUICommand x:Name="DeleteCommand"
                           Command="{Binding GridViewItemDeleteCommand}"
                           Description="Удалить элемент со стартовой страницы" />

    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height=".5*"></RowDefinition>
            <RowDefinition Height="1*"></RowDefinition>
            <RowDefinition Height=".8*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width=".5*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
            <ColumnDefinition Width=".5*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <resources:AuroraLite  Canvas.ZIndex="0" Grid.ColumnSpan="3" Grid.RowSpan="3"/>
        <Button Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" 
                    BorderThickness="2" Command="{Binding AddNewSiteCommand}">
            <Button.Content>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE710;"  />
                    <TextBlock Text="Добавить" Margin="10,0,0,0"></TextBlock>
                </StackPanel>

            </Button.Content>
        </Button>
        <Grid Grid.Row="2" Grid.Column="1" VerticalAlignment="Top" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width=".2*"/>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width=".2*"/>

            </Grid.ColumnDefinitions>
            <Image VerticalAlignment="Center" Source="{Binding LogoSource, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                   MaxWidth="56" MinWidth="28" HorizontalAlignment="Center" ></Image>
            <TextBox Grid.Column="1" Margin="5,0,5,0" Height="36" VerticalContentAlignment="Center" BorderThickness="0"
                     Text="{Binding SearchBoxText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     TextWrapping="NoWrap" FontSize="16" 
                     PlaceholderText="{Binding PlaceholderText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
            </TextBox>
            <Button Grid.Column="2" Height="36" HorizontalAlignment="Center" BorderThickness="0"  Command="{Binding SearchButtonTappedCommand}">
                <Button.Content>
                    <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE721;" />
                </Button.Content>
            </Button>
        </Grid>

        <!--<Button Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="30"
                Background="Transparent" BorderThickness="0" Padding="10">
                <Button.Content>
                    <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE713;" FontSize="24" />
                </Button.Content>
            </Button>-->

        <RelativePanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Margin="10">
            <GridView ItemsSource="{Binding StartPageItems, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                      SelectedItem="{Binding GridViewSelectedItem, Mode=TwoWay}" 
                      SelectionMode="Single" IsRightTapEnabled="True">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:SiteItem">
                        <Grid Width="110" Height="100">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Width="50" Height="50">
                                    <Rectangle Fill="{Binding ThirdBrush, Source={StaticResource ThemeManager}}" RadiusX="10" RadiusY="10"></Rectangle>
                                    <TextBlock Text="{x:Bind Url, Converter={StaticResource TitleLetterConverter}}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontSize="24" FontWeight="Bold"></TextBlock>
                                </Grid>
                                <TextBlock Grid.Row="1"  Text="{Binding Name, Converter={StaticResource TitleTextConverter}}" 
                                           TextAlignment="Center" FontSize="12" FontWeight="SemiBold" 
                                           Margin="0,10,0,0" ></TextBlock>
                            </Grid>
                            <FlyoutBase.AttachedFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Удалить" Command="{StaticResource DeleteCommand}" 
                                                    CommandParameter="{x:Bind }">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;"/>
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </FlyoutBase.AttachedFlyout>
                            <interactivity:Interaction.Behaviors>
                                <core:EventTriggerBehavior EventName="RightTapped">
                                    <commands:OpenFlyoutAction/>
                                </core:EventTriggerBehavior>
                            </interactivity:Interaction.Behaviors>
                            <ToolTipService.Placement>Mouse</ToolTipService.Placement>
                            <ToolTipService.ToolTip>
                                <TextBlock Text="{Binding Name}"></TextBlock>
                            </ToolTipService.ToolTip>
                            
                            
                            
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </RelativePanel>

    </Grid>

</Page>
