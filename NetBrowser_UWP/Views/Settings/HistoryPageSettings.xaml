<Page
    x:Class="NetBrowser_UWP.Views.Settings.HistoryPageSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:NetBrowser_UWP.ViewModels"
    xmlns:models="using:NetBrowser_UWP.Models"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:converters="using:NetBrowser_UWP.Converters"
    xmlns:settings="using:NetBrowser_UWP.ViewModels.Settings"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=settings:HistoryPageViewModel,IsDesignTimeCreatable=True}">

    <Page.Resources>
        <x:String x:Key="SearchPlaceholderText">Поиск в журнале истории</x:String>
        <StandardUICommand x:Name="DeleteCommand"
                           Command="{Binding DeleteCommand}"
                           Description="Удалить запись из истории" />
        <StandardUICommand x:Name="OpenCommand"
                           Command="{Binding OpenPageCommand}"
                           Description="Открыть страницу в браузере" />
        <StandardUICommand x:Name="ClearHistoryButtonCommand"
                           Command="{Binding OpenClearDialogCommand}"
                           Description="Очистить историю" />

        <converters:DateTimeToDateConverter x:Key="TimeConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="50,30,50,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="180" />
            </Grid.ColumnDefinitions>
            <TextBlock HorizontalAlignment="Left" Text="История" FontSize="40" VerticalAlignment="Top" Margin="0" />
            <TextBox Grid.Column="1" Height="30" MaxWidth="500" HorizontalAlignment="Stretch"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="{StaticResource SearchPlaceholderText}" Margin="0,0,0,0" />
            <Button HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" Grid.Column="2"
                    VerticalAlignment="Center"
                    Command="{StaticResource ClearHistoryButtonCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Очистить журнал" Margin="0,0,10,0" FontWeight="SemiBold" />
                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                </StackPanel>
            </Button>

        </Grid>

        <Grid Grid.Row="1" Margin="60,10,60,40">
            <ListView Background="{x:Null}" ItemsSource="{Binding HistoryList}" SelectionMode="Single"
                      HorizontalAlignment="Left"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <interactivity:Interaction.Behaviors>
                    <core:EventTriggerBehavior EventName="Tapped">
                        <core:InvokeCommandAction Command="{StaticResource OpenCommand}" />
                    </core:EventTriggerBehavior>
                </interactivity:Interaction.Behaviors>
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizationMode="Recycling" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:HistoryItemDetails" x:Name="DataTemplate">
                        <UserControl PointerEntered="ListViewItem_PointerEntered"
                                     PointerExited="ListViewItem_PointerExited">
                            <Grid Background="Transparent" Height="50">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="HoveringStates">
                                        <VisualState x:Name="HoverButtonsHidden" />
                                        <VisualState x:Name="HoverButtonsShown">
                                            <VisualState.Setters>
                                                <Setter Target="HoverButtons.Visibility"
                                                        Value="Visible" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <TextBlock Text="{x:Bind Time, Converter={StaticResource TimeConverter}}"
                                           VerticalAlignment="Center"
                                           FontSize="16" FontWeight="SemiBold" Grid.Column="0" />
                                <StackPanel Orientation="Vertical" Grid.Column="1" Margin="0,0,80,2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontSize="16"
                                               Margin="10,0" FontWeight="Bold" />
                                    <TextBlock Text="{x:Bind Url}" FontSize="12"
                                               HorizontalAlignment="Left" Margin="10,0" />
                                </StackPanel>
                                <TextBlock Text="{Binding Date}" VerticalAlignment="Center" FontSize="16"
                                           FontWeight="SemiBold" Grid.Column="2" />
                                <StackPanel x:Name="HoverButtons" Grid.Column="1"
                                            Orientation="Horizontal"
                                            Visibility="Collapsed"
                                            Margin="0,0,20,0"
                                            HorizontalAlignment="Right">
                                    <Button
                                        HorizontalAlignment="Right"
                                        Command="{StaticResource DeleteCommand}" CommandParameter="{Binding }"
                                        Padding="0"
                                        Style="{StaticResource ButtonRevealStyle}"
                                        Height="28" Width="28">
                                        <FontIcon Glyph="&#xE711;" FontSize="14" />
                                    </Button>

                                </StackPanel>

                            </Grid>
                        </UserControl>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>