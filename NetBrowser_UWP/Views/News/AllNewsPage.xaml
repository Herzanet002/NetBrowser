<Page
    x:Class="NetBrowser_UWP.Views.News.AllNewsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:ui="using:Microsoft.Toolkit.Uwp.UI"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:controls1="using:Microsoft.UI.Xaml.Controls"
    xmlns:media="using:Microsoft.Toolkit.Uwp.UI.Media"
    xmlns:news="using:NetBrowser_UWP.ViewModels.News"
    xmlns:models="using:NetBrowser.Core.Models"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=news:AllNewsPageViewModel,IsDesignTimeCreatable=True}"
    Background="{Binding Source={StaticResource ThemeManager}, Path=ThirdBrush}">
    <Page.Resources>
        <DataTemplate x:Key="NewsGridItemTemplate" x:DataType="models:ContentModel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="1.2*" />
                </Grid.RowDefinitions>
                <controls:ImageEx Grid.Row="0" Grid.RowSpan="4" Source="{x:Bind ImageUrl}" Stretch="UniformToFill"
                                  CornerRadius="8" Opacity="0.6">
                    <controls:ImageEx.Background>
                        <SolidColorBrush Color="Black" />
                    </controls:ImageEx.Background>
                </controls:ImageEx>
                <TextBlock Grid.Row="0" Text="{x:Bind FeederName}" FontSize="14" FontWeight="SemiBold"
                           Margin="10" Foreground="White" />
                <TextBlock Grid.Row="1" VerticalAlignment="Bottom" Text="{x:Bind Title}" FontSize="20"
                           FontWeight="SemiBold" Style="{ThemeResource BaseTextBlockStyle}"
                           Foreground="White" Margin="10, 0" />
                <TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="{x:Bind Description}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" MaxLines="2" Foreground="White" Margin="10, 0" />
                <Grid Grid.Row="3" RequestedTheme="Dark">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind PubDate}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="White"
                               VerticalAlignment="Center" Margin="10,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <AppBarButton Width="45" Height="45" ToolTipService.ToolTip="Добавить в закладки"
                                      Command="{Binding ElementName=AdaptiveGrid, Path=DataContext.AddNewsToFavoriteCommand}"
                                      CommandParameter="{x:Bind }">
                            <interactivity:Interaction.Behaviors>
                                <core:DataTriggerBehavior Binding="{x:Bind IsFavorite}" Value="True">
                                    <core:DataTriggerBehavior.Actions>
                                        <core:ChangePropertyAction
                                            PropertyName="Content">
                                            <core:ChangePropertyAction.Value>
                                                <FontIcon Glyph="&#xEB52;" />
                                            </core:ChangePropertyAction.Value>
                                        </core:ChangePropertyAction>
                                    </core:DataTriggerBehavior.Actions>
                                </core:DataTriggerBehavior>
                                <core:DataTriggerBehavior Binding="{x:Bind IsFavorite}" Value="False">
                                    <core:DataTriggerBehavior.Actions>
                                        <core:ChangePropertyAction
                                            PropertyName="Content">
                                            <core:ChangePropertyAction.Value>
                                                <FontIcon Glyph="&#xEB51;" />
                                            </core:ChangePropertyAction.Value>
                                        </core:ChangePropertyAction>
                                    </core:DataTriggerBehavior.Actions>
                                </core:DataTriggerBehavior>
                            </interactivity:Interaction.Behaviors>
                        </AppBarButton>
                        <AppBarButton Icon="Share" Width="45" Height="45" ToolTipService.ToolTip="Поделиться"
                                      Command="{Binding ElementName=AdaptiveGrid, Path=DataContext.ShareNewsCommand}"
                                      CommandParameter="{x:Bind }" />
                        <AppBarSeparator />
                    </StackPanel>
                </Grid>


            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RotatorTileTemplate" x:DataType="models:ContentModel">
            <Grid CornerRadius="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.RowSpan="2" CornerRadius="8">
                    <Border.Background>
                        <media:AcrylicBrush BackgroundSource="Backdrop"
                                            TintColor="Black"
                                            TintOpacity="0.2"
                                            BlurAmount="5" />
                    </Border.Background>
                </Border>
                <TextBlock Grid.Row="0" VerticalAlignment="Bottom" Text="{x:Bind Title}" FontSize="22"
                           FontWeight="SemiBold" Style="{ThemeResource BaseTextBlockStyle}"
                           Foreground="White" Margin="40, 0" />
                <Grid.Background>
                    <ImageBrush ImageSource="{x:Bind ImageUrl}" Stretch="UniformToFill" Opacity="0.7" />
                </Grid.Background>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="120" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <controls:RotatorTile x:Name="RotatorTile" Grid.Row="0" Margin="35, 15, 35, 0"
                              Height="100"
                              RotationDelay="0:0:5"
                              Direction="Left"
                              ItemsSource="{Binding News}"
                              ItemTemplate="{StaticResource RotatorTileTemplate}"
                              ui:FrameworkElementExtensions.Cursor="Hand">
            <interactivity:Interaction.Behaviors>
                <core:EventTriggerBehavior EventName="Tapped">
                    <core:InvokeCommandAction Command="{Binding RotatorTileClickCommand}"
                                              CommandParameter="{Binding ElementName=RotatorTile, Path=CurrentItem}" />
                </core:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>
        </controls:RotatorTile>

        <Grid Grid.Row="1" Margin="10" CornerRadius="8">
            <controls1:ProgressRing VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Foreground="{Binding AppTitleBrush, Source={StaticResource ThemeManager}}"
                                    IsActive="{Binding IsProgressRingActive}" />
            <controls:AdaptiveGridView ItemsSource="{Binding News}" Padding="15" StretchContentForSingleRow="False"
                                       OneRowModeEnabled="False" ItemClickCommand="{Binding AllNewsItemClickCommand}"
                                       IsItemClickEnabled="True"
                                       ItemHeight="300" x:Name="AdaptiveGrid"
                                       DesiredWidth="350" SelectedItem="{Binding SelectedItemInAllNews, Mode=TwoWay}"
                                       SelectionMode="Single" ItemTemplate="{StaticResource NewsGridItemTemplate}">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="BorderThickness" Value="5" />
                    </Style>
                </GridView.ItemContainerStyle>
            </controls:AdaptiveGridView>
        </Grid>

    </Grid>
</Page>