<Page
    x:Class="NetBrowser_UWP.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls" 
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:actions="using:NetBrowser_UWP.Commands"
    xmlns:models="using:NetBrowser_UWP.Models"
    xmlns:viewModels="using:NetBrowser_UWP.ViewModels"
    xmlns:controls="using:NetBrowser_UWP.Views.Controls"
    Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}"
    d:DataContext="{d:DesignInstance Type=viewModels:MainPageViewModel,IsDesignTimeCreatable=True}">

 

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36px"/>
            <RowDefinition Height="36px"/>
            <RowDefinition Height="4px"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*"/>
                <ColumnDefinition/>

            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding AppTitleText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Center" Margin="15,0" 
                       Foreground="{Binding AppTitleBrush, Source={StaticResource ThemeManager}}" FontSize="14" />
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Stretch" Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="500*"/>
                <ColumnDefinition Width="35" />
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

 
            <Button Grid.Column="1" Style="{StaticResource NavigationBarButtonStyle}" ToolTipService.ToolTip="Вернуться назад" 
                    Command="{Binding BackButtonCommand}"
                    ToolTipService.Placement="Bottom">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xF0D3;" />
            </Button>

            <Button Grid.Column="2" Command="{Binding ForwardButtonCommand}" Style="{StaticResource NavigationBarButtonStyle}">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xF0D2;" />
            </Button>

            <Button Grid.Column="3" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding ReloadButtonCommand}" 
                    Content="{Binding RefreshButtonIcon}"></Button>

            <Button Grid.Column="4" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding HomeButtonCommand}">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE80F;"/>
            </Button>

            <!--TODO: 
            GotFocus="AutoSuggestBox_GotFocus"
            QuerySubmitted="AutoSuggestBox_QuerySubmitted"-->
            <AutoSuggestBox  Style="{StaticResource AutoSuggestBoxTemplate}" x:Uid="SearchBoxPlaceholderText" Grid.Column="5"
                            Text="{Binding SearchBoxText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                            ItemsSource="{Binding SearchBoxItemsCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }">
                <i:Interaction.Behaviors>
                    <core:EventTriggerBehavior EventName="TextChanged">
                        <core:InvokeCommandAction Command="{Binding SearchBoxTextChangedCommand}" />
                    </core:EventTriggerBehavior>
                    <core:EventTriggerBehavior EventName="QuerySubmitted">
                        <core:InvokeCommandAction Command="{Binding SearchBoxQuerySubmittedCommand}" />
                    </core:EventTriggerBehavior>
                </i:Interaction.Behaviors>
            </AutoSuggestBox>

            <Button Background="Transparent" HorizontalAlignment="Left" Margin="15,0,0,0"
                    Padding="0" Width="28" Height="24" BorderBrush="Transparent"  Grid.Column="5"
                    VerticalAlignment="Center" >
                <StackPanel Orientation="Horizontal">
                    <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE72E;" Foreground="ForestGreen" FontSize="14"/>
                </StackPanel>

            </Button>
            <Button Background="Transparent" HorizontalAlignment="Right" Margin="0,0,20,0"
                    Padding="0" Width="28" Height="24" BorderBrush="Transparent" VerticalContentAlignment="Center" Grid.Column="5"
                    VerticalAlignment="Center" Command="{Binding AddBookmarkButtonCommand}" Content="{Binding AddBookmarkIcon}" >
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Orientation="Vertical" Width="350">
                            <TextBlock Text="Добавить закладку" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" HorizontalAlignment="Center"></TextBlock>
                            <TextBox Text="{Binding BookmarkTitleForSave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Заголовок" VerticalContentAlignment="Center" Margin="0,15,0,0"
                         TextWrapping="NoWrap" PlaceholderText="Название сайта"></TextBox>
                            <TextBox Text="{Binding BookmarkUrlForSave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Ссылка" VerticalContentAlignment="Center" Margin="0,10,0,0"
                         TextWrapping="NoWrap" PlaceholderText="Ссылка на сайт"></TextBox>
                            <Grid>
                                <Button Content="Отмена" HorizontalAlignment="Left" Margin="10,20,10,10" Command="{Binding CancelSaveBookmarkButtonCommand}"></Button>
                                <Button Content="Удалить" HorizontalAlignment="Center" Margin="0,20,30,10"
                                        Visibility="{Binding DeleteBookmarkButtonVisibility}" Command="{Binding DeleteBookmarkButtonCommand}"/>
                                <Button Content="Добавить" HorizontalAlignment="Right" Margin="10,20,10,10" Command="{Binding SaveBookmarkButtonCommand}"></Button>
                            </Grid>
                        </StackPanel>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button Grid.Column="6"
                    Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding SearchButtonCommand}">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}" Glyph="&#xE721;"/>
            </Button>

            <!--Bookmarks Flyout-->
            <Button Grid.Column="8" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding BookmarksButtonCommand}">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <Grid>
                            <StackPanel Width="300" >
                                <TextBlock Text="Сохраненные закладки" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15" 
                                           Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}"/>
                                <ListView MaxHeight="550" SelectionMode = "Single" IsItemClickEnabled = "True"
                                          ItemsSource="{Binding BookmarksList}" >
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:BookmarkDetails">
                                            <Grid Height="60">
                                                <StackPanel Orientation="Horizontal">
                                                    <BitmapIcon UriSource="{x:Bind Icon}"
                                                                ShowAsMonochrome="False" Height="20" Width="20"/>
                                                    <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Bottom" FontSize="16" 
                                                                   HorizontalAlignment="Left" Margin="10,0" FontWeight="Bold"/>
                                                        <TextBlock Text="{x:Bind Url}" FontSize="12" 
                                                                   VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <i:Interaction.Behaviors>
                                        <core:EventTriggerBehavior EventName="ItemClick">
                                            <core:InvokeCommandAction Command="{Binding BookmarksItemClickCommand}" />
                                        </core:EventTriggerBehavior>
                                    </i:Interaction.Behaviors>
                                </ListView>
                               
                                <Button Content="Параметры закладок"
                                        HorizontalAlignment="Center" Margin="0,15,0,0" Style="{StaticResource ButtonRevealStyle}"
                                        Command="{Binding BookmarksSettingsButtonCommand}" />
                                
                            </StackPanel>
                        </Grid>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}"
                          FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE728;"/>
            </Button>
            
            <!--History Flyout-->
            <Button Grid.Column="9" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding HistoryButtonCommand}">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Width="350"  >
                            <TextBlock Text="История" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,15"
                                       Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}"/>
                            <ListView MaxHeight="550"  SelectionMode = "Single" IsItemClickEnabled = "True" 
                                      ItemsSource="{Binding HistoryList}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:HistoryItemDetails">
                                        <Grid Height="50">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Bottom" FontSize="14"
                                               HorizontalAlignment="Left" Margin="0,0,10,0" FontWeight="Bold"></TextBlock>
                                                    <TextBlock Text="{Binding Url}" FontSize="11" 
                                               VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <i:Interaction.Behaviors>
                                    <core:EventTriggerBehavior EventName="ItemClick">
                                        <core:InvokeCommandAction Command="{Binding HistoryItemClickCommand}" />
                                    </core:EventTriggerBehavior>
                                </i:Interaction.Behaviors>
                            </ListView>
                            <Button Content="Настройка истории" Margin="0,10,0,0"
                                    HorizontalAlignment="Center" Style="{StaticResource ButtonRevealStyle}"
                                    Command="{Binding HistorySettingsButtonCommand}"></Button>
                            
                        </StackPanel>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}" FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xF738;"/>
            </Button>


            <Rectangle Grid.Column="10"  Width="2" Fill="{Binding SecondBrush, Source={StaticResource ThemeManager}}" Margin="8"/>

            <Button Grid.Column="11" Style="{StaticResource NavigationBarButtonStyle}">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE700;"/>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Параметры" Command="{Binding SettingsButtonCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE713;"></FontIcon>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

        </Grid>

        <muxc:ProgressBar Height="2" IsIndeterminate="True"
                          Visibility="{Binding ProgressBarVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Foreground="{Binding  AppTitleBrush, Source={StaticResource ThemeManager}}"
                          Grid.Row="2" HorizontalAlignment="Stretch"/>

        <Grid Grid.Row="3">
            <muxc:TabView TabItemsSource="{Binding TabViewItemsList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource TabViewStyleTemplate}"
                          SelectedItem="{Binding CurrentSelectedTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" AddTabButtonCommand="{Binding AddTabButtonCommand}"
                          Background="{Binding SecondBrush, Source={StaticResource ThemeManager}}">

                <i:Interaction.Behaviors>
                    <core:EventTriggerBehavior EventName="TabCloseRequested">
                        <core:InvokeCommandAction Command="{Binding CloseTabButtonCommand}"  />
                    </core:EventTriggerBehavior>
                </i:Interaction.Behaviors>

                <!--<muxc:TabView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewTabKeyboardAccelerator_Invoked" />
                    <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="CloseTabKeyboardAccelerator_Invoked" />
                </muxc:TabView.KeyboardAccelerators>-->
                <!--AddTabButtonClick="TabView_AddTabButtonClick" TabCloseRequested="TabView_TabCloseRequested"-->
            </muxc:TabView>
        </Grid>
    </Grid>

</Page>
