<ContentDialog
    x:Class="NetBrowser_UWP.Views.News.FirstRunRecommendationsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:news="using:NetBrowser_UWP.ViewModels.News"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:utils="using:NetBrowser.Utils"
    mc:Ignorable="d"
    Title="Для начала выберите категории новостей, которые вам нравятся"
    PrimaryButtonText="Продолжить"
    SecondaryButtonText="Отмена"
    PrimaryButtonCommand="{Binding OkButtonCommand}"
    IsPrimaryButtonEnabled="{Binding CanContinue}"
    Style="{StaticResource ContentDialogStyle}"
    d:DataContext="{d:DesignInstance Type=news:FirstRunRecommendationsViewModel,IsDesignTimeCreatable=True}">
    <interactivity:Interaction.Behaviors>
        <core:EventTriggerBehavior EventName="Loaded">
            <core:InvokeCommandAction Command="{Binding PageLoadedCommand}" />
        </core:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>
    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="ListViewCategoryTemplate" x:DataType="utils:RssFeeder">
                <Grid>
                    <TextBlock
                        Text="{x:Bind Name}" />
                    <ToolTipService.Placement>Mouse</ToolTipService.Placement>
                    <ToolTipService.ToolTip>
                        <TextBlock Text="{x:Bind Name}" />
                    </ToolTipService.ToolTip>
                </Grid>
            </DataTemplate>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <TextBlock Text="Выберите как минимум 3 категории" Margin="10" />
        <ListView Grid.Row="1" ItemsSource="{Binding Categories}" MaxHeight="500"
                  ItemTemplate="{StaticResource ListViewCategoryTemplate}"
                  SelectionMode="Multiple" IsMultiSelectCheckBoxEnabled="True">
            <interactivity:Interaction.Behaviors>
                <core:EventTriggerBehavior EventName="SelectionChanged">
                    <core:InvokeCommandAction Command="{Binding SelectionChangedCommand}" />
                </core:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>
        </ListView>

        <controls:ProgressRing Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{Binding CurrentTheme.AppTitleBrush, Source={StaticResource ThemeManager}}"
                               IsActive="{Binding IsProgressRingActive}" />

    </Grid>
</ContentDialog>