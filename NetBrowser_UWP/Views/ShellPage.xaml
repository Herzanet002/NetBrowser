<Page
    x:Class="NetBrowser_UWP.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:winUi="using:Microsoft.UI.Xaml.Controls"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:actions="using:NetBrowser_UWP.Commands"
    xmlns:models="using:NetBrowser_UWP.Models"
    xmlns:viewModels="using:NetBrowser_UWP.ViewModels"
    xmlns:helpers="using:NetBrowser_UWP.Helpers"
    xmlns:userControls="using:NetBrowser_UWP.Views.UserControls"
    xmlns:tools="using:Microsoft.Toolkit.Uwp.UI.Converters"
    Background="{Binding Path=CurrentTheme.BackgroundBrush, Source={StaticResource ThemeManager}}"
    d:DataContext="{d:DesignInstance Type=viewModels:ShellPageViewModel,IsDesignTimeCreatable=True}"
    IsTabStop="True">
    <i:Interaction.Behaviors>
        <core:EventTriggerBehavior EventName="Loaded">
            <core:InvokeCommandAction Command="{Binding LoadedPageCommand}" />
        </core:EventTriggerBehavior>
    </i:Interaction.Behaviors>
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary>
                    <!-- ReSharper disable Xaml.RedundantResource -->
                    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                    <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
                    <Style
                        x:Key="NavigationBarButtonStyle"
                        BasedOn="{StaticResource DefaultButtonStyle}"
                        TargetType="Button">
                        <Setter Property="Padding" Value="2" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="Width" Value="36" />
                        <Setter Property="Height" Value="32" />
                    </Style>
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.Resources>
            <tools:BoolNegationConverter x:Key="InvertBooleanConverter" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Row="0"
              Height="28"
              Background="{Binding CurrentTheme.BackgroundBrush, Source={StaticResource ThemeManager}}" >
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <winUi:ProgressRing IsActive="{Binding IsProgressRingActive}" 
                                    Height="10" 
                                    Width="10"
                                    Foreground="{Binding CurrentTheme.AppTitleBrush, Source={StaticResource ThemeManager}}" />
                <TextBlock
                    VerticalAlignment="Center" FontSize="14" Padding="0,4,0,0"
                    Foreground="{Binding CurrentTheme.AppTitleBrush, Source={StaticResource ThemeManager}}">
                    <Run Text="{helpers:ResourceString Name=AppTitle/Text}" />
                    <Run Text="{Binding AppTitleText}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Stretch"
              Background="{Binding CurrentTheme.BackgroundBrush, Source={StaticResource ThemeManager}}"
              ColumnSpacing="5" Height="46" Padding="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="600*" />
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--Back Button-->
            <Button Grid.Column="0" Style="{StaticResource NavigationBarButtonStyle}"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=BackButton/Tooltip}"
                    ToolTipService.Placement="Bottom" Command="{Binding BackButtonCommand}">
                <FontIcon Glyph="&#xF0D3;" FontSize="{StaticResource NavigationBarButtonFontSize}" />
            </Button>

            <!--Forward Button-->
            <Button Grid.Column="1" Command="{Binding ForwardButtonCommand}"
                    Style="{StaticResource NavigationBarButtonStyle}"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=ForwardButton/Tooltip}"
                    ToolTipService.Placement="Bottom">
                <FontIcon Glyph="&#xF0D2;" FontSize="{StaticResource NavigationBarButtonFontSize}" />
            </Button>

            <!--Refresh button-->
            <Button Grid.Column="2" Style="{StaticResource NavigationBarButtonStyle}"
                    Command="{Binding ReloadButtonCommand}"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=RefreshButton/Tooltip}"
                    ToolTipService.Placement="Bottom"
                    Visibility="{Binding IsWebLoading, Converter={StaticResource InvertBooleanConverter}}">
                <FontIcon Glyph="&#xE72C;" FontSize="{StaticResource NavigationBarButtonFontSize}" />
            </Button>

            <!--Stop loading button-->
            <Button Grid.Column="2" Style="{StaticResource NavigationBarButtonStyle}"
                    Command="{Binding StopLoadingButtonCommand}"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=StopLoadingButton/Tooltip}"
                    ToolTipService.Placement="Bottom" Visibility="{Binding IsWebLoading}">
                <FontIcon Glyph="&#xE711;" FontSize="20" />
            </Button>

            <!--Home button-->
            <Button Grid.Column="3" Style="{StaticResource NavigationBarButtonStyle}"
                    Command="{Binding HomeButtonCommand}"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=HomeButton/Tooltip}"
                    ToolTipService.Placement="Bottom" Visibility="{Binding IsHomeButtonEnabled}">
                <FontIcon Glyph="&#xE80F;" FontSize="{StaticResource NavigationBarButtonFontSize}" />
            </Button>

            <!--SearchBox-->
            <Grid Grid.Column="4" Margin="10,0,0,0">
                <userControls:FindSuggestBox />
            </Grid>

            <Button Grid.Column="6" Style="{StaticResource NavigationBarButtonStyle}"
                    Command="{Binding NewsContentButtonCommand}">
                <FontIcon Glyph="&#xE8A1;" FontSize="{StaticResource NavigationBarButtonFontSize}" />
            </Button>
            <!--Bookmarks Flyout-->
            <Button Grid.Column="7" Style="{StaticResource NavigationBarButtonStyle}"
                    Command="{Binding BookmarksButtonCommand}"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=BookmarksButton/Tooltip}"
                    ToolTipService.Placement="Bottom">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <Grid>
                            <StackPanel Width="300">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Сохраненные закладки" FontWeight="SemiBold" FontSize="16"
                                               Margin="0,10" HorizontalAlignment="Center"
                                               Foreground="{Binding CurrentTheme.ForegroundBrush, Source={StaticResource ThemeManager}}" />
                                    <Button Grid.Column="1" Width="32" Height="28" Padding="0"
                                            ToolTipService.ToolTip="Параметры закладок"
                                            Command="{Binding BookmarksSettingsButtonCommand}">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                    </Button>
                                </Grid>

                                <ListView MaxHeight="500" IsItemClickEnabled="True"
                                          ItemsSource="{Binding BookmarksList}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:BookmarkItem">
                                            <Grid Height="40">
                                                <StackPanel Orientation="Horizontal">
                                                    <BitmapIcon UriSource="{x:Bind FaviconUrl}"
                                                                ShowAsMonochrome="False" Width="18" Margin="0,0,10,0" />
                                                    <TextBlock Text="{x:Bind Name}" FontSize="14"
                                                               HorizontalAlignment="Left" VerticalAlignment="Center"
                                                               FontWeight="Bold" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <i:Interaction.Behaviors>
                                        <core:EventTriggerBehavior EventName="ItemClick">
                                            <core:InvokeCommandAction Command="{Binding BookmarksItemClickCommand}" />
                                        </core:EventTriggerBehavior>
                                    </i:Interaction.Behaviors>
                                </ListView>

                            </StackPanel>
                        </Grid>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                                      ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE728;" FontSize="{StaticResource NavigationBarButtonFontSize}" />
            </Button>

            <!--History Flyout-->
            <Button Grid.Column="8" Style="{StaticResource NavigationBarButtonStyle}"
                    Command="{Binding HistoryButtonCommand}"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=HistoryTitle}"
                    ToolTipService.Placement="Bottom">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Width="320">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="48" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="История" FontWeight="SemiBold" Margin="0,10"
                                           HorizontalAlignment="Center"
                                           FontSize="16"
                                           Foreground="{Binding CurrentTheme.ForegroundBrush, Source={StaticResource ThemeManager}}" />
                                <Button Grid.Column="1" Width="32" Height="28" Padding="0"
                                        ToolTipService.ToolTip="Параметры журнала истории"
                                        Command="{Binding HistorySettingsButtonCommand}">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                </Button>
                            </Grid>
                            <ListView MaxHeight="500" IsItemClickEnabled="True"
                                      ItemsSource="{Binding HistoryList}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:HistoryItem">
                                        <Grid Height="50">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="28" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Vertical" Margin="0,6,0,0">
                                                <TextBlock Text="{x:Bind Name}" FontSize="14"
                                                           HorizontalAlignment="Left" FontWeight="Bold" />
                                                <TextBlock Text="{x:Bind Url}" FontSize="11"
                                                           HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="14" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <i:Interaction.Behaviors>
                                    <core:EventTriggerBehavior EventName="ItemClick">
                                        <core:InvokeCommandAction Command="{Binding HistoryItemClickCommand}" />
                                    </core:EventTriggerBehavior>
                                </i:Interaction.Behaviors>
                            </ListView>
                        </StackPanel>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                                      ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xF738;" FontSize="{StaticResource NavigationBarButtonFontSize}" />
            </Button>


            <Rectangle Grid.Column="9" Width="1" Fill="{Binding CurrentTheme.SecondBrush, Source={StaticResource ThemeManager}}"
                       Margin="10" />

            <!--Settings button-->
            <Button Grid.Column="10" Style="{StaticResource NavigationBarButtonStyle}"
                    ToolTipService.ToolTip="{helpers:ResourceString Name=SettingsButton/Tooltip}"
                    ToolTipService.Placement="Bottom">
                <FontIcon Glyph="&#xE712;" FontSize="{StaticResource NavigationBarButtonFontSize}" />
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="{helpers:ResourceString Name=Settings/Title}"
                                        Command="{Binding SettingsButtonCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="{helpers:ResourceString Name=TaskManager/Text}"
                                        Command="{Binding TaskManagerButtonCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7C4;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="{helpers:ResourceString Name=DeveloperInstruments/Text}"
                                        Command="{Binding DeveloperInstrumentsButtonCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEC7A;" />
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

        </Grid>

        <userControls:CustomTabViewControl Grid.Row="2"/>
    </Grid>
</Page>