<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:String x:Key="NameOfTheme">LightLilac</x:String>
    <x:Int32 x:Key="ThemeMode">1</x:Int32>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF8B8ABB" />
    <SolidColorBrush x:Key="SecondBrush" Color="#FF9B9AD0" />
    <SolidColorBrush x:Key="ThirdBrush" Color="#FFE0E0F1" />
    <SolidColorBrush x:Key="AppTitleBrush" Color="#B2251675" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF353535" />
    <SolidColorBrush x:Key="NavigationButtonBrush" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="SearchBoxForeground" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="SearchBoxBorderBrush" Color="#FF553790" />
    <SolidColorBrush x:Key="BookmarkSavedBrush" Color="#FF246F8D" />
</ResourceDictionary>