<ContentDialog
    x:Class="NetBrowser_UWP.Views.UserControls.EditBookmarkDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:NetBrowser_UWP.ViewModels"
    xmlns:settings="using:NetBrowser_UWP.ViewModels.Settings"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=settings:BookmarksPageViewModel,IsDesignTimeCreatable=True}"
    Style="{StaticResource ContentDialogStyle}"
    Title="Редактирование закладки"
    PrimaryButtonText="ОК"
    SecondaryButtonText="Отмена"
    PrimaryButtonCommand="{Binding SaveEditedBookmarkCommand}">
    <Grid>
        <StackPanel>
            <TextBox Header="Заголовок" VerticalContentAlignment="Center" Margin="0,10,0,0"
                     TextWrapping="NoWrap" PlaceholderText="Название сайта"
                     Text="{Binding BookmarkNewTitle, Mode=TwoWay}" />
            <TextBox Header="Ссылка" VerticalContentAlignment="Center" Margin="0,10,0,0"
                     TextWrapping="NoWrap" Text="{Binding BookmarkNewUrl, Mode=TwoWay}"
                     PlaceholderText="Ссылка на сайт" />

        </StackPanel>

    </Grid>
</ContentDialog>