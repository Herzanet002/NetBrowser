<Page
    x:Class="NetBrowser_UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP"
    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls" d:DataContext="{d:DesignInstance Type=local:MainPage}"
    Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40px"/>
            <RowDefinition Height="40px"/>
            <RowDefinition Height="5px"/>
            <RowDefinition/>

        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}">
            <TextBlock Grid.Row="0" Text="{x:Bind AppTitleText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Center" Margin="15,0"  
                   Foreground="{Binding AppTitleBrush, Source={StaticResource ThemeManager}}" FontSize="14" />
            <TextBlock Grid.Row="0" Text="{StaticResource AppVersion}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,150,0" FontSize="12"
                   Foreground="{StaticResource ResourceKey=transparentFg}"/>
        </Grid>



        <Grid x:Name="NavBar" Grid.Row="1" HorizontalAlignment="Stretch" Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="500*"/>
                <ColumnDefinition Width="35" />
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="1" Style="{StaticResource NavigationBarButtonStyle}">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xF0D3;" Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}"/>
            </Button>
            <Button x:Name="ForwardButton" Grid.Column="2" Click="forwardBtn_Click" Style="{StaticResource NavigationBarButtonStyle}">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xF0D2;" Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}"/>
            </Button>
            <Button x:Name="RefreshButton" Grid.Column="3" Style="{StaticResource NavigationBarButtonStyle}" Click="refreshBtn_Click">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE72C;" Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}"/>
            </Button>
            <Button x:Name="HomeButton" Grid.Column="4" Style="{StaticResource NavigationBarButtonStyle}" Click="homeBtn_Click">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE80F;" Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}"/>
            </Button>

            <!--SearchBox Item-->
            <TextBox Style="{StaticResource SearchBoxStyle}" PlaceholderText="{StaticResource SearchBoxPlaceholderText}"   
                      KeyDown="searchBox_KeyDown" Grid.Row="1" Grid.Column="5" FontFamily="{StaticResource Segoe Fluent}"
                      Text="{Binding SearchBoxText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      >
                
            </TextBox>
            <!--Text="{Binding Path=SearchBoxText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"-->
            <Button x:Name="SslBtn" Background="Transparent" HorizontalAlignment="Left" Margin="16,0,0,2"
                    Padding="0" Width="30" Height="25" BorderBrush="Transparent" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="5"
                    VerticalAlignment="Center" >
                <StackPanel Orientation="Horizontal">

                    <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE72E;" Foreground="ForestGreen" FontSize="14"></FontIcon>

                </StackPanel>



            </Button>
            <Button x:Name="AddBookmarksButton" Background="Transparent" HorizontalAlignment="Right" Margin="0,0,20,2"
                    Padding="0" Width="30" Height="25" BorderBrush="Transparent" VerticalContentAlignment="Center" Grid.Row="1" Grid.Column="5"
                    VerticalAlignment="Center" Click="addBookmarksBtn_Click" >
                <Button.Flyout>
                    <Flyout Placement="Bottom" x:Name="BookmarkFlyout">
                        <StackPanel Orientation="Vertical" Width="350">
                            <TextBlock Text="Добавить закладку" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" HorizontalAlignment="Center"></TextBlock>
                            <TextBox x:Name="BookmarkTitle" Header="Заголовок" VerticalContentAlignment="Center" Margin="0,15,0,0"
                         TextWrapping="NoWrap" PlaceholderText="Название сайта"></TextBox>
                            <TextBox x:Name="BookmarkUrl" Header="Ссылка" VerticalContentAlignment="Center" Margin="0,10,0,0"
                         TextWrapping="NoWrap" PlaceholderText="Ссылка на сайт"></TextBox>
                            <Grid>
                                <Button x:Name="CancelBookmarksBtn" Content="Отмена" HorizontalAlignment="Left" Margin="10,20,10,10" Click="CancelBookmarksBtn_Click"></Button>
                                <Button x:Name="DeleteBookmarkBtn" Content="Удалить" HorizontalAlignment="Center" Margin="0,20,30,10" Visibility="Collapsed" Click="DeleteBookmarkBtn_Click"/>
                                <Button x:Name="SaveBookmarkBtn" Content="Добавить" HorizontalAlignment="Right" Margin="10,20,10,10" Click="SaveBookmarkBtn_Click"></Button>
                            </Grid>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE734;" FontSize="14" />
            </Button>

            <Button x:Name="SearchButton" Grid.Column="6" Background="Transparent"
                    Style="{StaticResource NavigationBarButtonStyle}"
                    Click="searchBtn_Click">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}" Glyph="&#xE721;"/>
            </Button>

            <Button x:Name="BookmarksButton" Grid.Column="8" Style="{StaticResource NavigationBarButtonStyle}" Click="bookmarksBtn_Click">
                <Button.Flyout>
                    <Flyout Placement="Bottom" x:Name="FlyoutBookmarks">
                        <Grid>
                            <StackPanel Width="300" >
                                <TextBlock Text="Сохраненные закладки" HorizontalAlignment="Center" Margin="0,0,0,15" 
                                           Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}"/>
                                <ListView x:Name="BookmarksFlyoutListView" Height="auto" MaxHeight="600" 
                                          SelectionMode = "Single" IsItemClickEnabled = "True"
                                      Background="{x:Null}" ItemClick="bookmarksFlyoutListView_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="60">
                                                <StackPanel Orientation="Horizontal">
                                                    <BitmapIcon UriSource="{Binding Icon}"
                                                ShowAsMonochrome="False" Height="20" Width="20"></BitmapIcon>
                                                    <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Bottom" FontSize="16"
                                               HorizontalAlignment="Left" Margin="10,0" FontWeight="Bold"></TextBlock>
                                                        <TextBlock Grid.Row="1" Text="{Binding Url}" FontSize="12" 
                                               VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button x:Name="BookmarkSettingButton" Content="Параметры закладок"
                                        HorizontalAlignment="Center" Margin="0,15,0,0" Style="{StaticResource ButtonRevealStyle}" Click="bookmarkSettingBtn_Click" />
                            </StackPanel>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}" FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE728;"/>
            </Button>
            <Button x:Name="HistoryButton" Grid.Column="9" Style="{StaticResource NavigationBarButtonStyle}"
                    Click="historyBtn_Click">
                <Button.Flyout>
                    <Flyout Placement="Bottom" x:Name="FlyoutHistory">
                        <StackPanel Width="350" >
                            <TextBlock Text="История" HorizontalAlignment="Center" Margin="0,10,0,15"
                                       Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}"/>
                            <ListView x:Name="HistoryListView" Height="auto" MaxHeight="600" SelectionMode = "Single" IsItemClickEnabled = "True"
                                      Background="Transparent" ItemClick="historyListView_ItemClick" >
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="50">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Bottom" FontSize="14"
                                               HorizontalAlignment="Left" Margin="10,0" FontWeight="Bold"></TextBlock>
                                                    <TextBlock Grid.Row="1" Text="{Binding Url}" FontSize="11" 
                                               VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button x:Name="ClearHistory" Content="Очистить историю" Margin="0,10,0,0"
                                    HorizontalAlignment="Center" Style="{StaticResource ButtonRevealStyle}"></Button>

                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}" FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xF738;"/>
            </Button>

            <Rectangle Grid.Column="10"  Width="2" Fill="{Binding SecondBrush, Source={StaticResource ThemeManager}}" 
                       Margin="8" Style="{StaticResource ColorPickerBorderStyle}"
                       ></Rectangle>
            <Button x:Name="SettingBtn" Grid.Column="11" Style="{StaticResource NavigationBarButtonStyle}">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE713;" Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}"></FontIcon>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Параметры" Click="settingsBtn_Click">
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

        </Grid>

        <muxc:ProgressBar x:Name="BrowserProgress" Height="2" IsIndeterminate="True" 
                              ShowPaused="False" ShowError="False" Visibility="Collapsed" Foreground="{Binding AppTitleBrush, Source={StaticResource ThemeManager}}"
                                          VerticalAlignment="Top" HorizontalAlignment="Stretch" Grid.Row="2" VerticalContentAlignment ="Top" Margin="0">


        </muxc:ProgressBar>
        <Grid Grid.Row="3" Background="#FF1B1B1B" >
            <muxc:TabView x:Name="TabsControl" 
                          AddTabButtonClick="tabView_AddTabButtonClick" TabCloseRequested="tabView_TabCloseRequested"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="0"  
                          Background="{Binding SecondBrush, Source={StaticResource ThemeManager}}" SelectionChanged="tabView_SelectionChanged" 
                          Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}">
                <muxc:TabView.TabItems>
                    <muxc:TabViewItem x:Name="DefaultTab" Header="Новая вкладка">
                        <WebView x:Name="Browser" Visibility="Visible" DefaultBackgroundColor="#FF1B1B1B" />
                    </muxc:TabViewItem>
                </muxc:TabView.TabItems>
            </muxc:TabView>
        </Grid>
    </Grid>

</Page>
