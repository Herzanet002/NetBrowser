<Page
    x:Class="NetBrowser_UWP.BookmarksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    Background="{StaticResource mainBg}"
    x:Name="bookmarksPage" Loaded="bookmarksPage_Loaded">

    <Grid>
        <ListView Background="{x:Null}" x:Name="bookmarksListView" Margin="10,20,20,10"
                  IsItemClickEnabled="True" SelectionMode="Single" IsTapEnabled="True" Tapped="bookmarksListView_Tapped">
            <ListView.Resources>
                <MenuFlyout x:Name="bookmarkMenuFlyout" Placement="Bottom">
                    <MenuFlyout.Items>
                        <MenuFlyoutItem x:Name="Open" Text="Открыть закладку" Click="Open_Click"   >
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE774;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="Edit"  Text="Редактировать" Click="Edit_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEB7E;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="Remove" Text="Удалить" Click="Remove_Click"  >
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8BB;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        
                    </MenuFlyout.Items>
                </MenuFlyout>
            </ListView.Resources>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Height="60">
                        <StackPanel Orientation="Horizontal">
                            <BitmapIcon UriSource="{Binding Icon}"
                                                ShowAsMonochrome="False" Height="20" Width="20"></BitmapIcon>
                            <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Bottom" FontSize="16"
                                               HorizontalAlignment="Left" Margin="10,0" FontWeight="Bold"></TextBlock>
                                <TextBlock Grid.Row="1" Text="{Binding Url}" FontSize="12" 
                                               VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <ContentDialog x:Name="editingBookmarkDialog" VerticalAlignment="Stretch"
                       Title="Редактирование закладки"
                       PrimaryButtonText="OK"
                       SecondaryButtonText="Отмена" RequestedTheme="Dark" IsPrimaryButtonEnabled="True">

            <StackPanel>
                <TextBox x:Name="bookmarkNewTitle" Header="Заголовок" VerticalContentAlignment="Center" Margin="0,10,0,0"
                         TextWrapping="NoWrap" PlaceholderText="Название сайта"></TextBox>
                <TextBox x:Name="bookmarkNewUrl" Header="Ссылка" VerticalContentAlignment="Center" Margin="0,10,0,0"
                         TextWrapping="NoWrap" PlaceholderText="Ссылка на сайт"></TextBox>

            </StackPanel>
            
        </ContentDialog>

    </Grid>

    
</Page>
