<Page
    x:Class="NetBrowser_UWP.Views.News.RecommendationsNewsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:NetBrowser_UWP.ViewModels"
    xmlns:news="using:NetBrowser_UWP.ViewModels.News"
    xmlns:converters="using:NetBrowser_UWP.Converters"
    xmlns:models="using:NetBrowser_UWP.Models"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:syndication="using:System.ServiceModel.Syndication"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:controls1="using:Microsoft.UI.Xaml.Controls"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=news:RecommendationsNewsPageViewModel,IsDesignTimeCreatable=True}"
    Background="{Binding Source={StaticResource ThemeManager}, Path=ThirdBrush}">
    <interactivity:Interaction.Behaviors>
        <core:EventTriggerBehavior EventName="Loaded">
            <core:InvokeCommandAction Command="{Binding RecommendationsNewsPageLoadedCommand}" />
        </core:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>
    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="ListViewCategoryTemplate" x:DataType="syndication:SyndicationCategory">
                <Grid>
                    <TextBlock
                            Text="{x:Bind Name}"/>
                    <ToolTipService.Placement>Mouse</ToolTipService.Placement>
                    <ToolTipService.ToolTip>
                        <TextBlock Text="{x:Bind Name}" />
                    </ToolTipService.ToolTip>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="NewsGridItemTemplate" x:DataType="models:ContentModel">
                <Grid>
                    <Grid.RowDefinitions>

                        <RowDefinition Height="4*" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="1.2*" />
                    </Grid.RowDefinitions>
                    <controls:ImageEx Grid.Row="0" Grid.RowSpan="3" Source="{x:Bind ImageUrl}" Stretch="UniformToFill"
                                  CornerRadius="8" Opacity="0.6">
                        <controls:ImageEx.Background>
                            <SolidColorBrush Color="Black"/>
                        </controls:ImageEx.Background>
                    </controls:ImageEx>
                    <TextBlock Grid.Row="0" VerticalAlignment="Bottom" Text="{x:Bind Title}" FontSize="20"
                               FontWeight="SemiBold" Style="{ThemeResource BaseTextBlockStyle}"
                               Foreground="White" Margin="10, 0" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Bottom" Text="{x:Bind Description}"
                           Style="{ThemeResource BodyTextBlockStyle}"
                           TextTrimming="CharacterEllipsis" MaxLines="2" Foreground="White" Margin="10, 0" />
                    <Grid Grid.Row="2" RequestedTheme="Dark">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind PubDate}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="White"
                               VerticalAlignment="Center" Margin="10,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <AppBarButton Width="45" Height="45" ToolTipService.ToolTip="Добавить в закладки"
                                      Command="{Binding ElementName=AdaptiveGrid, Path=DataContext.AddNewsToFavoriteCommand}"
                                      CommandParameter="{x:Bind }">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xEB51;"></FontIcon>
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Icon="Share" Width="45" Height="45" ToolTipService.ToolTip="Поделиться"
                                      Command="{Binding ElementName=AdaptiveGrid, Path=DataContext.ShareNewsCommand}"
                                      CommandParameter="{x:Bind }"/>
                            <AppBarSeparator/>
                        </StackPanel>
                    </Grid>


                </Grid>
            </DataTemplate>
        </Grid.Resources>


        <Grid Grid.Row="0" Margin="10" CornerRadius="8">
            <controls1:ProgressRing VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Foreground="{Binding AppTitleBrush, Source={StaticResource ThemeManager}}"
                                    IsActive="{Binding IsProgressRingActive}" />
            <controls:AdaptiveGridView ItemsSource="{Binding RecommendedNews}" Padding="15" StretchContentForSingleRow="False"
                                       OneRowModeEnabled="False" 
                                       IsItemClickEnabled="True"
                                       ItemHeight="300" x:Name="AdaptiveGrid"
                                       DesiredWidth="350" 
                                       SelectionMode="Single" ItemTemplate="{StaticResource NewsGridItemTemplate}">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="BorderThickness" Value="5" />
                    </Style>
                </GridView.ItemContainerStyle>
                <interactivity:Interaction.Behaviors>
                    <core:EventTriggerBehavior EventName="Tapped">
                        <core:InvokeCommandAction Command="{Binding ItemOpenCommand}"
                                                  CommandParameter="{Binding SelectedItem, ElementName=AdaptiveGrid}" />
                    </core:EventTriggerBehavior>
                </interactivity:Interaction.Behaviors>
            </controls:AdaptiveGridView>
            <StackPanel Grid.Row="0" Margin="30" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20"
                        Visibility="{Binding IsConfiguredHidden}">
                <TextBlock HorizontalTextAlignment="Center" VerticalAlignment="Center"
                           FontSize="24">
                    <Run Text="Для начала выберите категории новостей, которые вам нравятся"/>
                    <Run Text="&#xE76E;" FontFamily="Segoe Fluent Icons"/>
                </TextBlock>
                <Button Content="Выбрать категории" HorizontalAlignment="Center" 
                        Command="{Binding CategoriesButtonSetCommand}"></Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>