<Application
    x:Class="NetBrowser_UWP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP" 
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="mainBg" Color="#1A374D"></SolidColorBrush>
            <SolidColorBrush x:Key="sthBg" Color="#406882"></SolidColorBrush>
            <SolidColorBrush x:Key="thBg" Color="#6998AB"></SolidColorBrush>
            <SolidColorBrush x:Key="mainfg" Color="#C9CCD5"></SolidColorBrush>

            
        </ResourceDictionary>
        

    </Application.Resources>

</Application>
