<Page
    x:Class="NetBrowser_UWP.Views.News.FavoritesNewsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:news="using:NetBrowser_UWP.ViewModels.News"
    xmlns:controls="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:utils="using:NetBrowser.Utils"
    mc:Ignorable="d"
    Background="{Binding Source={StaticResource ThemeManager}, Path=ThirdBrush}"
    d:DataContext="{d:DesignInstance Type=news:FavoriteNewsPageViewModel,IsDesignTimeCreatable=True}">
    <interactivity:Interaction.Behaviors>
        <core:EventTriggerBehavior EventName="Loaded">
            <core:InvokeCommandAction Command="{Binding FavoriteNewsPageLoadedCommand}" />
        </core:EventTriggerBehavior>
    </interactivity:Interaction.Behaviors>

    <Page.Resources>
        <DataTemplate x:Key="ListViewItemNewsTemplate" x:DataType="utils:ContentModel">
            <Grid Margin="0,12,0,12">
                <Grid Margin="12,0,0,0" ColumnSpacing="40">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>

                    <Border Padding="5,0,5,0" CornerRadius="6"
                            Background="{Binding Source={StaticResource ThemeManager}, Path=AppTitleBrush}">
                        <controls:ImageEx Source="{x:Bind Feeder.FeederImageLink}" MinWidth="80" Height="50"
                                          HorizontalAlignment="Stretch" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{ThemeResource BodyTextBlockStyle}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxLines="3" HorizontalTextAlignment="Left"
                               FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="{x:Bind PubDate}" FontWeight="SemiBold" Margin="10,0"
                               Style="{ThemeResource CaptionTextBlockStyle}"
                               VerticalAlignment="Center" HorizontalAlignment="Left" />
                    <Button Grid.Column="3" Width="50" Height="35" Style="{StaticResource TabViewButtonStyle}">
                        <Button.Content>
                            <FontIcon Glyph="&#xE712;" />
                        </Button.Content>
                        <Button.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Убрать из избранных" CommandParameter="{x:Bind}"
                                                Command="{Binding DataContext.RemoveNewsCommand, ElementName=ListViewPresenter}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xEA92;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Поделиться"
                                                Command="{Binding DataContext.ShareNewsCommand, ElementName=ListViewPresenter}"
                                                CommandParameter="{x:Bind}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE72D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Margin="30">
        <ListView x:Name="ListViewPresenter" ItemsSource="{Binding FavoriteNews, UpdateSourceTrigger=PropertyChanged}"
                  CanReorderItems="True"
                  ScrollViewer.HorizontalScrollBarVisibility="Visible"
                  ScrollViewer.VerticalScrollBarVisibility="Visible"
                  SelectedItem="{Binding SelectedItemNews, Mode=TwoWay}"
                  ScrollViewer.IsVerticalRailEnabled="True" ItemTemplate="{StaticResource ListViewItemNewsTemplate}">
            <interactivity:Interaction.Behaviors>
                <core:EventTriggerBehavior EventName="SelectionChanged">
                    <core:InvokeCommandAction Command="{Binding ItemOpenCommand}"
                                              CommandParameter="{Binding SelectedItem, ElementName=ListViewPresenter}" />
                </core:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>
        </ListView>
    </Grid>
</Page>