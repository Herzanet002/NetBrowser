<Application
    x:Class="NetBrowser_UWP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP" 
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="mainBg" Color="#283149"></SolidColorBrush>
            <SolidColorBrush x:Key="sthBg" Color="#404B69"></SolidColorBrush>
            <SolidColorBrush x:Key="thBg" Color="#00818A"></SolidColorBrush>
            <SolidColorBrush x:Key="mainfg" Color="#B5EAEA"></SolidColorBrush>

            <Style TargetType="Rectangle" x:Key="HorizontalSeparator">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Margin" Value="10,3"/>
                <Setter Property="Fill" Value="{StaticResource thBg}"/>
            </Style>
        </ResourceDictionary>
        

    </Application.Resources>

</Application>
