<Application
    x:Class="NetBrowser_UWP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP" 
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="mainBg" Color="#FF1E2327"/>
            <SolidColorBrush x:Key="sthBg" Color="#FF373F50"/>
            <SolidColorBrush x:Key="thBg" Color="#334756"/>
            <SolidColorBrush x:Key="appTitleFg" Color="#7F97C1EF"/>
            <SolidColorBrush x:Key="mainfg" Color="#FFEFEF"/>
            <SolidColorBrush x:Key="betaFg" Color="#FF6BD6DE"/>
            <SolidColorBrush x:Key="errorBg" Color="#FF381E1E"/>




        </ResourceDictionary>
        

    </Application.Resources>

</Application>
