<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:String x:Key="NameOfTheme">Light</x:String>
    <x:Int32 x:Key="ThemeMode">1</x:Int32>

    <SolidColorBrush x:Key="BackgroundBrush" Color="#FFA9AFB5" />
    <SolidColorBrush x:Key="SecondBrush" Color="#FFDDDFE2" />
    <SolidColorBrush x:Key="ThirdBrush" Color="#FFEDEDED" />
    <SolidColorBrush x:Key="AppTitleBrush" Color="#7F080808" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="NavigationButtonBrush" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="SearchBoxForeground" Color="#FF2D2D2D" />
    <SolidColorBrush x:Key="SearchBoxBorderBrush" Color="#FF445469" />
    <SolidColorBrush x:Key="BookmarkSavedBrush" Color="#FF246F8D" />
</ResourceDictionary>