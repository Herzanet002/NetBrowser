<ContentDialog
    x:Class="NetBrowser_UWP.Views.UserControls.AddNewStartPageItemDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="using:NetBrowser_UWP.ViewModels"
    mc:Ignorable="d"
    Style="{StaticResource ContentDialogStyle}"
    Title="Добавить веб-сайт"
    PrimaryButtonText="ОК"
    SecondaryButtonText="Отмена"
    PrimaryButtonCommand="{Binding SaveNewSiteCommand}"
    d:DataContext="{d:DesignInstance Type=viewModels:StartPageViewModel,IsDesignTimeCreatable=True}">

    <Grid>
        <StackPanel>
            <TextBox Header="Заголовок" VerticalContentAlignment="Center" Margin="0,10,0,0"
                     TextWrapping="NoWrap" PlaceholderText="Название сайта"
                     Text="{Binding NewSiteName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Header="Ссылка" VerticalContentAlignment="Center" Margin="0,10,0,0"
                     TextWrapping="NoWrap"
                     Text="{Binding NewSiteUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     PlaceholderText="Ссылка на сайт" />

        </StackPanel>

    </Grid>
</ContentDialog>