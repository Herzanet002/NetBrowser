<Page
    x:Class="NetBrowser_UWP.Views.Settings.PersonalizePageSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="300"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Text="Персонализация" FontSize="40" Grid.Row="0"
                   Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" Margin="50,30,0,20"/>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="Выбор темы" FontSize="26" Grid.Row="1" 
                   Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" Margin="70,0,0,0" />
        <Grid Grid.Row="2" Margin="50,20,50,20" >
            <GridView x:Name="ThemeChooserGridView" Tapped="ThemeChooserGridView_Tapped">
                <GridView.Items>
                    <GridViewItem>
                        <Grid Margin="20,20,20,20" Width="120" Height="100" >
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="/Themes/Theme.Light.xaml"></ResourceDictionary>
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </Grid.Resources>
                            <Rectangle Fill="{StaticResource ThirdBrush}" Width="120" Height="70" VerticalAlignment="Top"
                                RadiusX="3" RadiusY="3" Grid.ColumnSpan="2"  />
                            <Rectangle Fill="{StaticResource BackgroundBrush}" Width="110" Height="60" Grid.ColumnSpan="2" Margin="5,5,5,5" VerticalAlignment="Top"/>
                            <Rectangle Fill="{StaticResource SecondBrush}" Width="110" Height="20" Margin="5,5,5,45" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Source={StaticResource NameOfTheme}}" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="12"></TextBlock>
                        </Grid>
                    </GridViewItem>
                    <GridViewItem>
                        <Grid Margin="20,20,20,20" Width="120" Height="100">
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="/Themes/Theme.Dark.xaml"></ResourceDictionary>
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </Grid.Resources>
                            <Rectangle Fill="{StaticResource ThirdBrush}" Width="120" Height="70" VerticalAlignment="Top"
                                RadiusX="3" RadiusY="3" Grid.ColumnSpan="2"  />
                            <Rectangle Fill="{StaticResource BackgroundBrush}" Width="110" Height="60" Grid.ColumnSpan="2" Margin="5,5,5,5" VerticalAlignment="Top"/>
                            <Rectangle Fill="{StaticResource SecondBrush}" Width="110" Height="20" Margin="5,5,5,45" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Source={StaticResource NameOfTheme}}" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="12"></TextBlock>

                        </Grid>
                    </GridViewItem>
                    <GridViewItem>
                        <Grid Margin="20,20,20,20" Width="120" Height="100">
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="/Themes/Theme.DarkBlue.xaml"></ResourceDictionary>
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </Grid.Resources>
                            <Rectangle Fill="{StaticResource ThirdBrush}" Width="120" Height="70" VerticalAlignment="Top"
                                RadiusX="3" RadiusY="3" Grid.ColumnSpan="2"  />
                            <Rectangle Fill="{StaticResource BackgroundBrush}" Width="110" Height="60" Grid.ColumnSpan="2" Margin="5,5,5,5" VerticalAlignment="Top"/>
                            <Rectangle Fill="{StaticResource SecondBrush}" Width="110" Height="20" Margin="5,5,5,45" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Source={StaticResource NameOfTheme}}" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="12"></TextBlock>

                        </Grid>
                    </GridViewItem>
                    <GridViewItem>
                        <Grid Margin="20,20,20,20" Width="120" Height="100">
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="/Themes/Theme.LightPink.xaml"></ResourceDictionary>
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </Grid.Resources>
                            <Rectangle Fill="{StaticResource ThirdBrush}" Width="120" Height="70" VerticalAlignment="Top"
                                RadiusX="3" RadiusY="3" Grid.ColumnSpan="2"  />
                            <Rectangle Fill="{StaticResource BackgroundBrush}" Width="110" Height="60" Grid.ColumnSpan="2" Margin="5,5,5,5" VerticalAlignment="Top"/>
                            <Rectangle Fill="{StaticResource SecondBrush}" Width="110" Height="20" Margin="5,5,5,45" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Source={StaticResource NameOfTheme}}" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="12"></TextBlock>

                        </Grid>
                    </GridViewItem>
                    <GridViewItem>

                        <Grid Margin="20,20,20,20" Width="120" Height="100">
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="/Themes/Theme.LightBlue.xaml"></ResourceDictionary>
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </Grid.Resources>
                            <Rectangle Fill="{StaticResource ThirdBrush}" Width="120" Height="70" VerticalAlignment="Top"
                                RadiusX="3" RadiusY="3" Grid.ColumnSpan="2"  />
                            <Rectangle Fill="{StaticResource BackgroundBrush}" Width="110" Height="60" Grid.ColumnSpan="2" Margin="5,5,5,5" VerticalAlignment="Top"/>
                            <Rectangle Fill="{StaticResource SecondBrush}" Width="110" Height="20" Margin="5,5,5,45" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Source={StaticResource NameOfTheme}}" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="12"></TextBlock>

                        </Grid>
                    </GridViewItem>
                    <GridViewItem>
                    <Grid Margin="20,20,20,20" Width="120" Height="100">
                        <Grid.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="/Themes/Theme.Dark.NavyBlue.xaml"></ResourceDictionary>
                                </ResourceDictionary.MergedDictionaries>
                            </ResourceDictionary>
                        </Grid.Resources>
                        <Rectangle Fill="{StaticResource ThirdBrush}" Width="120" Height="70" VerticalAlignment="Top"
                                RadiusX="3" RadiusY="3" Grid.ColumnSpan="2"  />
                        <Rectangle Fill="{StaticResource BackgroundBrush}" Width="110" Height="60" Grid.ColumnSpan="2" Margin="5,5,5,5" VerticalAlignment="Top"/>
                        <Rectangle Fill="{StaticResource SecondBrush}" Width="110" Height="20" Margin="5,5,5,45" VerticalAlignment="Top"/>
                        <TextBlock Text="{Binding Source={StaticResource NameOfTheme}}" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="12"></TextBlock>

                    </Grid>
                        </GridViewItem>
                    <GridViewItem>
                        <Grid Margin="20,20,20,20" Width="120" Height="100">
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="/Themes/Theme.Dark.Acrylic.xaml"></ResourceDictionary>
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </Grid.Resources>
                            <Rectangle Fill="{StaticResource ThirdBrush}" Width="120" Height="70" VerticalAlignment="Top"
                                RadiusX="3" RadiusY="3" Grid.ColumnSpan="2"  />
                            <Rectangle Fill="{StaticResource BackgroundBrush}" Width="110" Height="60" Grid.ColumnSpan="2" Margin="5,5,5,5" VerticalAlignment="Top"/>
                            <Rectangle Fill="{StaticResource SecondBrush}" Width="110" Height="20" Margin="5,5,5,45" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Source={StaticResource NameOfTheme}}" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="12"></TextBlock>
                        </Grid>
                    </GridViewItem>
                    <GridViewItem>
                        <Grid Margin="20,20,20,20" Width="120" Height="100">
                            <Grid.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="/Themes/Theme.Light.Acrylic.xaml"></ResourceDictionary>
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </Grid.Resources>
                            <Rectangle Fill="{StaticResource ThirdBrush}" Width="120" Height="70" VerticalAlignment="Top"
                                       RadiusX="3" RadiusY="3" Grid.ColumnSpan="2"  />
                            <Rectangle Fill="{StaticResource BackgroundBrush}" Width="110" Height="60" Grid.ColumnSpan="2" Margin="5,5,5,5" VerticalAlignment="Top"/>
                            <Rectangle Fill="{StaticResource SecondBrush}" Width="110" Height="20" Margin="5,5,5,45" VerticalAlignment="Top"/>
                            <TextBlock Text="{Binding Source={StaticResource NameOfTheme}}" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="12"></TextBlock>
                        </Grid>
                    </GridViewItem>
                </GridView.Items>
            </GridView>
        </Grid>
    </Grid>
</Page>
