<Page
    x:Class="NetBrowser_UWP.Views.Settings.BookmarksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewmodels="using:NetBrowser_UWP.ViewModels"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Text="Закладки" FontSize="40" Grid.Row="0"
                   Margin="50,30,0,20"/>

        <Grid Grid.Row="1" Margin="50,0,0,0">
            <Grid.DataContext>
                <viewmodels:BookmarksPageViewModel/>
            </Grid.DataContext>
            <ListView Background="{x:Null}" ItemsSource="{Binding BookmarksList,
                UpdateSourceTrigger=PropertyChanged}" FlyoutBase.AttachedFlyout="{x:Bind BookmarkMenuFlyout}"
                      SelectedItem="{Binding SelectedBookmark, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Tapped="BookmarksListView_Tapped">
                <ListView.Resources>
                    <MenuFlyout x:Name="BookmarkMenuFlyout" Placement="Bottom">
                        <MenuFlyout.Items>
                            <MenuFlyoutItem Text="Открыть закладку" Command="{Binding OpenBookmarkCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE774;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Редактировать" Command="{Binding EditBookmarkCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEB7E;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Удалить" Command="{Binding DeleteBookmarkCommand}"  >
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D9;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                        </MenuFlyout.Items>
                    </MenuFlyout>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="60">
                            <StackPanel Orientation="Horizontal">
                                <BitmapIcon UriSource="{Binding Icon}"
                                                ShowAsMonochrome="False" Height="20" Width="20"></BitmapIcon>
                                <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Bottom" FontSize="16"
                                               HorizontalAlignment="Left" Margin="10,0" FontWeight="Bold"/>

                                    <TextBlock Text="{Binding Url}" FontSize="12" 
                                               VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>


    </Grid>


</Page>
