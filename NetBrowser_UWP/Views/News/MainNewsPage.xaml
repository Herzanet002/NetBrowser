<Page
    x:Class="NetBrowser_UWP.Views.News.NewsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP.Views.News"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NetBrowser_UWP.Models"
    xmlns:viewModels="using:NetBrowser_UWP.ViewModels"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:wctoolkit="using:Microsoft.Toolkit.Uwp.UI.Controls"
    xmlns:ui="using:Microsoft.Toolkit.Uwp.UI"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:behaviors="using:Microsoft.Toolkit.Uwp.UI.Behaviors"
    xmlns:media="using:Microsoft.Toolkit.Uwp.UI.Media"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    d:DataContext="{d:DesignInstance Type=viewModels:NewsPageViewModel,IsDesignTimeCreatable=True}"
    controls:BackdropMaterial.ApplyToRootOrPageBackground="True">

    <Page.Resources>
        <DataTemplate x:Key="NewsGridItemTemplate" x:DataType="models:ContentModel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>
                <wctoolkit:ImageEx Grid.Row="0" Grid.RowSpan="4" Source="{x:Bind ImageUrl}" Stretch="UniformToFill" CornerRadius="8"
                                   Opacity="0.6">
                    <wctoolkit:ImageEx.Background>
                        <SolidColorBrush Color="Black"></SolidColorBrush>
                    </wctoolkit:ImageEx.Background>
                </wctoolkit:ImageEx>
                <TextBlock Grid.Row="0" Text="{x:Bind Feeder}" Foreground="Azure" FontSize="14" FontWeight="SemiBold" Margin="10"></TextBlock>
                <TextBlock Grid.Row="1" VerticalAlignment="Bottom" Text="{x:Bind Title}" FontSize="20" FontWeight="SemiBold" Style="{ThemeResource BaseTextBlockStyle}"
                           Foreground="White" Margin="10, 0"/>
                <TextBlock Grid.Row="2" VerticalAlignment="Bottom" Text="{x:Bind Description}" Style="{ThemeResource BodyTextBlockStyle}"
                                       TextTrimming="CharacterEllipsis" MaxLines="2" Foreground="White" Margin="10, 0"/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind PubDate}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="White" 
                               Margin="10, 10" VerticalAlignment="Bottom"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <AppBarButton Icon="Like" Width="45" Height="45"/>
                        <AppBarButton Icon="Share" Width="45" Height="45" Command="{Binding ElementName=AdaptiveGrid, Path=DataContext.ShareNewsCommand}"
                                      CommandParameter="{Binding }"/>
                        <AppBarSeparator/>
                        <AppBarButton Width="45" Height="45">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE7BC;"></FontIcon>
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton Width="45" Height="45">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE734;"></FontIcon>
                            </AppBarButton.Icon>
                        </AppBarButton>

                    </StackPanel>
                </Grid>


            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="RotatorTileTemplate" x:DataType="models:ContentModel">
            <Grid CornerRadius="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="4*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.RowSpan="2" CornerRadius="8">
                    <Border.Background>
                        <media:AcrylicBrush BackgroundSource="Backdrop"
                                             TintColor="Black"
                                             TintOpacity="0.2"
                                             BlurAmount="5"/>
                    </Border.Background>
                </Border>
                <TextBlock Grid.Row="0" VerticalAlignment="Bottom" Text="{x:Bind Title}" FontSize="22" FontWeight="SemiBold" Style="{ThemeResource BaseTextBlockStyle}"
                           Foreground="White" Margin="40, 0"/>
                <Grid.Background>
                    <ImageBrush ImageSource="{x:Bind ImageUrl}" Stretch="UniformToFill" Opacity="0.7"></ImageBrush>
                </Grid.Background>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="4*"/>
        </Grid.ColumnDefinitions>

        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Text="Новости" FontSize="40" Grid.Row="0"
                       Margin="30,50,0,0"/>
        <wctoolkit:RotatorTile x:Name="RotatorTile" Grid.Row="0" Margin="15" Grid.Column="1"
                               Height="100"
                               RotationDelay="0:0:5"
                               Direction="Left"
                               ItemsSource="{Binding News}"
                               ItemTemplate="{StaticResource RotatorTileTemplate}"
                               ui:FrameworkElementExtensions.Cursor="Hand">
            <interactivity:Interaction.Behaviors>
                <core:EventTriggerBehavior EventName="Tapped">
                    <core:InvokeCommandAction Command="{Binding RotatorTileClickCommand}" CommandParameter="{Binding ElementName=RotatorTile, Path=CurrentItem}"/>
                </core:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>
        </wctoolkit:RotatorTile>


        <Grid Grid.Row="1" Grid.Column="0" CornerRadius="8" Background="{Binding Source={StaticResource ThemeManager}, Path=ThirdBrush}"
              Margin="10">
        </Grid>

        <Grid Grid.Row="1" Background="{Binding Source={StaticResource ThemeManager}, Path=ThirdBrush}" 
              Margin="10" CornerRadius="8" Grid.Column="1">

            <controls:ProgressRing VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{Binding AppTitleBrush, Source={StaticResource ThemeManager}}"
                                   IsActive="{Binding IsProgressRingActive}"></controls:ProgressRing>
            <wctoolkit:AdaptiveGridView ItemsSource="{Binding News}" Padding="15" StretchContentForSingleRow="False"
                                        OneRowModeEnabled="False"
                                        ItemHeight="300" x:Name="AdaptiveGrid"
                                        DesiredWidth="350"
                                        SelectionMode="Single" ItemTemplate="{StaticResource NewsGridItemTemplate}">
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="BorderThickness" Value="5"></Setter>
                    </Style>
                </GridView.ItemContainerStyle>
            </wctoolkit:AdaptiveGridView>
        </Grid>

    </Grid>



</Page>
