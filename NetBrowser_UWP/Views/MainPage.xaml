<Page
    x:Class="NetBrowser_UWP.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:winUi="using:Microsoft.UI.Xaml.Controls" 
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:actions="using:NetBrowser_UWP.Commands"
    xmlns:models="using:NetBrowser_UWP.Models"
    xmlns:viewModels="using:NetBrowser_UWP.ViewModels"
    xmlns:converters="using:NetBrowser_UWP.Converters"
    Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}"
    d:DataContext="{d:DesignInstance Type=viewModels:MainPageViewModel,IsDesignTimeCreatable=True}">

    <Grid>
        <Grid.Resources>
            <converters:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
            <converters:DomainNameConverter x:Key="DomainNameConverter"/>
            <Style x:Name="NavigationBarButtonStyle" BasedOn="{StaticResource ButtonRevealStyle}" TargetType="Button">
                <Setter Property="Background" Value="Transparent"></Setter>
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="Padding" Value="0"></Setter>
                <Setter Property="Width" Value="30"></Setter>
                <Setter Property="Height" Value="30"></Setter>
                <Setter Property="BorderThickness" Value="1"></Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <Storyboard>
                                                <PointerUpThemeAnimation Storyboard.TargetName="RootGrid"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.(RevealBrush.State)" Value="PointerOver"/>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource ButtonRevealBackgroundPointerOver}"/>
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ButtonRevealBorderBrushPointerOver}"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPointerOver}"/>
                                            </VisualState.Setters>
                                            <Storyboard>
                                                <PointerUpThemeAnimation Storyboard.TargetName="RootGrid"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.(RevealBrush.State)" Value="Pressed"/>
                                                <Setter Target="RootGrid.Background" Value="{ThemeResource ButtonRevealBackgroundPressed}"/>
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ButtonRevealBorderBrushPressed}"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundPressed}"/>
                                            </VisualState.Setters>
                                            <Storyboard>
                                                <PointerDownThemeAnimation Storyboard.TargetName="RootGrid"/>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="RootGrid.Background" Value="{x:Null}"/>
                                                <Setter Target="ContentPresenter.BorderBrush" Value="{ThemeResource ButtonRevealBorderBrushDisabled}"/>
                                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundDisabled}"/>
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="ContentPresenter" AutomationProperties.AccessibilityView="Raw"
                                                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" 
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" CornerRadius="{TemplateBinding CornerRadius}" 
                                                  Content="{TemplateBinding Content}" ContentTransitions="{TemplateBinding ContentTransitions}" 
                                                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                                  Padding="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="30px"/>
            <RowDefinition Height="38px"/>
            <!--<RowDefinition Height="4px"/>-->
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
               
                <winUi:ProgressRing Visibility="{Binding ProgressBarVisibility, Mode=TwoWay}" Height="10" Width="10"
                                    Foreground="{Binding  AppTitleBrush, Source={StaticResource ThemeManager}}">
                    
                </winUi:ProgressRing>
                <TextBlock Text="{Binding AppTitleText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                       VerticalAlignment="Center" Margin="15,0" FontSize="12" HorizontalTextAlignment="Center"
                       Foreground="{Binding AppTitleBrush, Source={StaticResource ThemeManager}}"/>
            </StackPanel>
            
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Stretch" Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="500*"/>
                <ColumnDefinition Width="35" />
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <!--Back Button-->
            <Button Grid.Column="1" Style="{StaticResource NavigationBarButtonStyle}" ToolTipService.ToolTip="Вернуться назад" 
                    ToolTipService.Placement="Bottom" FontSize="18" 
                    Command="{Binding BackButtonCommand}">
                <FontIcon Glyph="&#xF0D3;" FontSize="18" />
            </Button>
            <!--Forward Button-->
            <Button Grid.Column="2" Command="{Binding ForwardButtonCommand}" Style="{StaticResource NavigationBarButtonStyle}"
                    ToolTipService.ToolTip="Перейти вперед" ToolTipService.Placement="Bottom">
                <FontIcon Glyph="&#xF0D2;" FontSize="18" />
            </Button>

            <!--Refresh button-->
            <Button Grid.Column="3" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding ReloadButtonCommand}" 
                        ToolTipService.ToolTip="Обновить страницу" ToolTipService.Placement="Bottom" Visibility="{Binding IsWebLoading, Converter={StaticResource InvertBooleanConverter}}">
                <FontIcon Glyph="&#xE72C;" FontSize="18"/>

            </Button>
            <!--Stop loading button-->
            <Button Grid.Column="3" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding StopLoadingButtonCommand}" 
                    ToolTipService.ToolTip="Остановить загрузку" ToolTipService.Placement="Bottom" Visibility="{Binding IsWebLoading}">
                <FontIcon Glyph="&#xE711;" FontSize="22"/>
            </Button>

            <!--Home button-->
            <Button Grid.Column="4" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding HomeButtonCommand}"
                    ToolTipService.ToolTip="Домашняя страница" ToolTipService.Placement="Bottom">
                <FontIcon Glyph="&#xE80F;" FontSize="18"/>
            </Button>

            <!--SearchBox-->
            <AutoSuggestBox Style="{StaticResource AutoSuggestBoxTemplate}" x:Uid="SearchBoxPlaceholderText" Grid.Column="5"
                            Text="{Binding SearchBoxText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            UpdateTextOnSelect="True"
                            ItemsSource="{Binding SearchBoxItemsCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }">

                <i:Interaction.Behaviors>
                    <core:EventTriggerBehavior EventName="TextChanged">
                        <core:InvokeCommandAction Command="{Binding SearchBoxTextChangedCommand}" />
                    </core:EventTriggerBehavior>
                    <core:EventTriggerBehavior EventName="QuerySubmitted">
                        <core:InvokeCommandAction Command="{Binding SearchBoxQuerySubmittedCommand}" />
                    </core:EventTriggerBehavior>
                </i:Interaction.Behaviors>
            </AutoSuggestBox>

            <!--Security cerificate check button-->
            <Button Background="Transparent" HorizontalAlignment="Left" Margin="15,0,0,0"
                    Padding="0" Width="28" Height="24" BorderBrush="Transparent"  Grid.Column="5"
                    VerticalAlignment="Center">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Spacing="10">
                            <StackPanel>
                                <TextBlock Text="{Binding SearchBoxText, Converter={StaticResource DomainNameConverter}}"
                                           FontWeight="SemiBold" HorizontalTextAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xE72E;" FontSize="16"></FontIcon>
                                <TextBlock Text="Подключение защищено"></TextBlock>
                            </StackPanel>
                        </StackPanel>
                        
                    </Flyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE72E;" Foreground="ForestGreen" FontSize="14"/>
                </StackPanel>
            </Button>

            <!--AddBookmarkButton with Flyout-->
            <Button Background="Transparent" HorizontalAlignment="Right" Margin="0,0,20,0"
                    Padding="0" Width="28" Height="24" BorderBrush="Transparent" VerticalContentAlignment="Center" Grid.Column="5"
                    VerticalAlignment="Center" Command="{Binding AddBookmarkButtonCommand}"
                    ToolTipService.ToolTip="Добавить страницу в закладки" ToolTipService.Placement="Bottom">
                <i:Interaction.Behaviors>
                    <core:DataTriggerBehavior Binding="{Binding IsBookmarksExists}" Value="True" >
                        <core:DataTriggerBehavior.Actions>
                            <core:ChangePropertyAction
                                PropertyName="Content">
                                <core:ChangePropertyAction.Value>
                                    <FontIcon Glyph="&#xE735;" FontSize="14" Foreground="{Binding BookmarkSavedBrush, Source={StaticResource ThemeManager}}"></FontIcon>
                                </core:ChangePropertyAction.Value>
                            </core:ChangePropertyAction>
                        </core:DataTriggerBehavior.Actions>
                    </core:DataTriggerBehavior>
                    <core:DataTriggerBehavior Binding="{Binding IsBookmarksExists}" Value="False" >
                        <core:DataTriggerBehavior.Actions>
                            <core:ChangePropertyAction
                                PropertyName="Content">
                                <core:ChangePropertyAction.Value>
                                    <FontIcon Glyph="&#xE734;" FontSize="14"></FontIcon>
                                </core:ChangePropertyAction.Value>
                            </core:ChangePropertyAction>
                        </core:DataTriggerBehavior.Actions>
                    </core:DataTriggerBehavior>
                </i:Interaction.Behaviors>
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Orientation="Vertical" Width="350">
                            <TextBlock Text="Добавить закладку" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"
                                       Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" ></TextBlock>
                            <TextBox Text="{Binding BookmarkTitleForSave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Header="Заголовок" VerticalContentAlignment="Center" Margin="0,15" PlaceholderText="Название сайта"></TextBox>
                            <TextBox Text="{Binding BookmarkUrlForSave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Ссылка"
                                     VerticalContentAlignment="Center" Margin="0,10" PlaceholderText="Ссылка на сайт"></TextBox>
                            <Grid>
                                <Button Content="Отмена" HorizontalAlignment="Left" Margin="10,20,10,10" Command="{Binding CancelSaveBookmarkButtonCommand}"></Button>
                                <Button Content="Удалить" HorizontalAlignment="Center" Margin="0,20,30,10"
                                        Visibility="{Binding DeleteBookmarkButtonVisibility}" Command="{Binding DeleteBookmarkButtonCommand}"/>
                                <Button Content="Добавить" HorizontalAlignment="Right" Margin="10,20,10,10" Command="{Binding SaveBookmarkButtonCommand}"></Button>
                            </Grid>
                        </StackPanel>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!--Search Button-->
            <Button Grid.Column="6" ToolTipService.ToolTip="Поиск" ToolTipService.Placement="Bottom"
                    Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding SearchButtonCommand}">
                <FontIcon Glyph="&#xE721;"/>
            </Button>

            <!--Bookmarks Flyout-->
            <Button Grid.Column="8" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding BookmarksButtonCommand}"
                    ToolTipService.ToolTip="Закладки" ToolTipService.Placement="Bottom">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <Grid>
                            <StackPanel Width="300">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Сохраненные закладки" FontWeight="SemiBold" FontSize="16" Margin="0,10" HorizontalAlignment="Center"
                                               Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}"/>
                                    <Button Grid.Column="1" Width="28" Height="28" Padding="0" ToolTipService.ToolTip="Параметры закладок" 
                                            Command="{Binding BookmarksSettingsButtonCommand}">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                                    </Button>
                                </Grid>

                                <ListView MaxHeight="500" SelectionMode="Single" IsItemClickEnabled="True"
                                          ItemsSource="{Binding BookmarksList}" >
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:BookmarkDetails">
                                            <Grid Height="40">
                                                <StackPanel Orientation="Horizontal">
                                                    <BitmapIcon UriSource="{x:Bind Icon}"
                                                                ShowAsMonochrome="False" Height="20" Width="18" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{x:Bind Name}" FontSize="14" 
                                                               HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <i:Interaction.Behaviors>
                                        <core:EventTriggerBehavior EventName="ItemClick">
                                            <core:InvokeCommandAction Command="{Binding BookmarksItemClickCommand}" />
                                        </core:EventTriggerBehavior>
                                    </i:Interaction.Behaviors>
                                </ListView>

                            </StackPanel>
                        </Grid>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xE728;"/>
            </Button>

            <!--History Flyout-->
            <Button Grid.Column="9" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding HistoryButtonCommand}"
                    ToolTipService.ToolTip="Журнал истории" ToolTipService.Placement="Bottom">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Width="320">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="История" FontWeight="SemiBold" Margin="0,10" HorizontalAlignment="Center"
                                           FontSize="16" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}"/>
                                <Button Grid.Column="1" Width="28" Height="28" Padding="0" ToolTipService.ToolTip="Параметры журнала истории" 
                                              Command="{Binding HistorySettingsButtonCommand}">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                                </Button>
                            </Grid>
                            <ListView MaxHeight="500" SelectionMode="Single" IsItemClickEnabled="True" 
                                      ItemsSource="{Binding HistoryList}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:HistoryItemDetails">
                                        <Grid Height="50" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Vertical" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding Name}"  FontSize="14"
                                                HorizontalAlignment="Left" FontWeight="Bold"></TextBlock>
                                                <TextBlock Text="{Binding Url}" FontSize="11" 
                                                HorizontalAlignment="Left" />
                                            </StackPanel>
                                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="14" />

                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <i:Interaction.Behaviors>
                                    <core:EventTriggerBehavior EventName="ItemClick">
                                        <core:InvokeCommandAction Command="{Binding HistoryItemClickCommand}" />
                                    </core:EventTriggerBehavior>
                                </i:Interaction.Behaviors>
                            </ListView>
                        </StackPanel>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Glyph="&#xF738;"/>
            </Button>


            <Rectangle Grid.Column="10"  Width="2" Fill="{Binding SecondBrush, Source={StaticResource ThemeManager}}" Margin="8"/>

            <!--Settings button-->
            <Button Grid.Column="11" Style="{StaticResource NavigationBarButtonStyle}" ToolTipService.ToolTip="Параметры" ToolTipService.Placement="Bottom">
                <FontIcon Glyph="&#xE712;" FontSize="18"/>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Параметры" Command="{Binding SettingsButtonCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;"></FontIcon>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Диспетчер задач" Command="{Binding TaskManagerButtonCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE7C4;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Инструменты разработчика" Command="{Binding DeveloperInstrumentsButtonCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEC7A;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

        </Grid>

        <!--<winUi:ProgressBar Height="2" IsIndeterminate="True"
                          Visibility="{Binding ProgressBarVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Foreground="{Binding  AppTitleBrush, Source={StaticResource ThemeManager}}"
                          Grid.Row="2" HorizontalAlignment="Stretch"/>-->

        <Grid Grid.Row="2">
            <Grid.Resources>
                <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
            </Grid.Resources>
            <winUi:TabView TabItemsSource="{Binding TabViewItemsList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           Style="{StaticResource TabViewStyleTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                           SelectedItem="{Binding CurrentSelectedTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           AddTabButtonCommand="{Binding AddTabButtonCommand}" 
                           Background="{Binding SecondBrush, Source={StaticResource ThemeManager}}">

                <i:Interaction.Behaviors>
                    <core:EventTriggerBehavior EventName="TabCloseRequested">
                        <core:InvokeCommandAction Command="{Binding CloseTabButtonCommand}"  />
                    </core:EventTriggerBehavior>
                </i:Interaction.Behaviors>

                <!--<muxc:TabView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewTabKeyboardAccelerator_Invoked" />
                    <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="CloseTabKeyboardAccelerator_Invoked" />
                </muxc:TabView.KeyboardAccelerators>-->
                <!--AddTabButtonClick="TabView_AddTabButtonClick" TabCloseRequested="TabView_TabCloseRequested"-->
            </winUi:TabView>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding TabViewItemsList.Count, Converter={StaticResource IntToVisibilityConverter}}">
                <TextBlock Text="Нет открытых вкладок" VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="24"/>
                <TextBlock Text="Чтобы начать работу, создайте новую вкладку..." VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14"/>
            </StackPanel>
        </Grid>


    </Grid>

</Page>
