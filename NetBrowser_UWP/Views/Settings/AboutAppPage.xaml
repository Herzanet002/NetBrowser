<Page
    x:Class="NetBrowser_UWP.Views.Settings.AboutAppPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="using:NetBrowser_UWP.Resources"
    xmlns:helpers="using:NetBrowser_UWP.Helpers">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="100" />
        </Grid.RowDefinitions>
        <resources:AuroraLite Grid.RowSpan="3" />
        <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="20">
            <Image Source="/Resources/Logos/AppLogo.png" Width="96" VerticalAlignment="Center"
                   HorizontalAlignment="Center" />
            <TextBlock HorizontalTextAlignment="Center" VerticalAlignment="Center" Text="NetBrowser" FontSize="30"
                       FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="15">

            <TextBlock Text="{helpers:ResourceString Name=BrowserVersionBlock/Text}" HorizontalTextAlignment="Center"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}">
                <Run Text="{Binding AppVersion}" />
            </TextBlock>

            <TextBlock Text="{helpers:ResourceString Name=BuiltOnTechnologyBlock/Text}"
                       HorizontalTextAlignment="Center"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}">
                <Run Text="{Binding WebViewVersion}" />
            </TextBlock>
        </StackPanel>

        <TextBlock Grid.Row="2" Margin="40" HorizontalTextAlignment="Right">
            <Span>
                <Run Text="{helpers:ResourceString Name=RunOnOpenSourceProject/Text}" />
                <Hyperlink NavigateUri="https://www.chromium.org/chromium-projects/">Chromium</Hyperlink>
            </Span>
        </TextBlock>
    </Grid>
</Page>