<Page
    x:Class="NetBrowser_UWP.Views.Settings.PersonalizePageSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:viewmodels="using:NetBrowser_UWP.ViewModels"
    xmlns:models="using:NetBrowser_UWP.Models"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=viewmodels:PersonalizePageViewModel,IsDesignTimeCreatable=True}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="350"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Text="Персонализация" FontSize="40" Grid.Row="0"
                   Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" Margin="50,30,0,20"/>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="Выбор темы" FontSize="26" Grid.Row="1" 
                   Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" Margin="70,0,0,0" />

        <Grid Grid.Row="2" Margin="50,20,50,20" >
            <GridView ItemsSource="{Binding ThemesList}" 
                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:ThemeItem">
                        <Grid Margin="15" Width="110" Height="70">
                            <Rectangle Fill="{Binding ThirdBrush}" Width="110" Height="70" VerticalAlignment="Top"
                                       RadiusX="3" RadiusY="3" Grid.ColumnSpan="2"  />
                            <Rectangle Fill="{Binding BackgroundBrush}" Width="100" Height="60" Margin="5,5,5,5" VerticalAlignment="Top"/>
                            <Rectangle Fill="{Binding SecondBrush}" Width="100" Height="20" Margin="5,5,5,45" VerticalAlignment="Top"/>
                            <!--<TextBlock Text="{Binding  Name}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,5" FontSize="12"></TextBlock>-->
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
                <interactivity:Interaction.Behaviors>
                    <core:EventTriggerBehavior EventName="Tapped">
                        <core:InvokeCommandAction Command="{Binding SelectThemeCommand}" />
                    </core:EventTriggerBehavior>
                </interactivity:Interaction.Behaviors>
            </GridView>
        </Grid>
        <Grid Row="3" Margin="50,20,50,20" >
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel>
            <TextBlock Text="Отображать последние поисковые запросы на стартовой странице"/>
            <ToggleSwitch IsOn="True"/>


            </StackPanel>


        </Grid>
    </Grid>
</Page>
