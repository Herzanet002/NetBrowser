<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <x:String x:Key="NameOfTheme">DarkNavyBlue</x:String>
    <x:Int32 x:Key="ThemeMode">2</x:Int32>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#FF072B47" />
    <SolidColorBrush x:Key="SecondBrush" Color="#FF0C4C7D" />
    <SolidColorBrush x:Key="ThirdBrush" Color="#FF093A60" />
    <SolidColorBrush x:Key="AppTitleBrush" Color="#A57BA5D4" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavigationButtonBrush" Color="#FFEFEF" />
    <SolidColorBrush x:Key="SearchBoxForeground" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="SearchBoxBorderBrush" Color="#FF445469" />
    <SolidColorBrush x:Key="BookmarkSavedBrush" Color="#FF5493AC" />
</ResourceDictionary>