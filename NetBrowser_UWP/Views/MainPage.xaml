<Page
    x:Class="NetBrowser_UWP.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:i="using:Microsoft.Xaml.Interactivity"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls" 
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:actions="using:NetBrowser_UWP.Commands"
    xmlns:models="using:NetBrowser_UWP.Models"
    xmlns:viewModels="using:NetBrowser_UWP.ViewModels"
    Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}"
    d:DataContext="{d:DesignInstance Type=viewModels:MainPageViewModel,IsDesignTimeCreatable=True}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32px"/>
            <RowDefinition Height="36px"/>
            <RowDefinition Height="4px"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="180"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding AppTitleText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Center" Margin="15,0" 
                       Foreground="{Binding AppTitleBrush, Source={StaticResource ThemeManager}}" FontSize="14" />
            <PersonPicture Grid.Column="1" Width="24" HorizontalAlignment="Left"></PersonPicture>
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Stretch" Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="500*"/>
                <ColumnDefinition Width="35" />
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>


            <Button Grid.Column="1" Style="{StaticResource NavigationBarButtonStyle}" ToolTipService.ToolTip="Вернуться назад" 
                    ToolTipService.Placement="Bottom" FontSize="18"
                    Command="{Binding BackButtonCommand}" >
                <FontIcon Glyph="&#xF0D3;" FontSize="18"/>
            </Button>

            <Button Grid.Column="2" Command="{Binding ForwardButtonCommand}" Style="{StaticResource NavigationBarButtonStyle}"
                    ToolTipService.ToolTip="Перейти вперед" ToolTipService.Placement="Bottom">
                <FontIcon Glyph="&#xF0D2;" FontSize="18"/>
            </Button>

            <Button Grid.Column="3" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding ReloadButtonCommand}" 
                    ToolTipService.ToolTip="Обновить стрницу" ToolTipService.Placement="Bottom"
                    Content="{Binding RefreshButtonIcon}"/>

            <Button Grid.Column="4" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding HomeButtonCommand}"
                    ToolTipService.ToolTip="Домашняя страница" ToolTipService.Placement="Bottom">
                <FontIcon Glyph="&#xE80F;" FontSize="18"/>
            </Button>

            <!--SearchBox--> 
            <AutoSuggestBox Style="{StaticResource AutoSuggestBoxTemplate}" x:Uid="SearchBoxPlaceholderText" Grid.Column="5"
                            Text="{Binding SearchBoxText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" 
                            ItemsSource="{Binding SearchBoxItemsCollection, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged }">
                <i:Interaction.Behaviors>
                    <core:EventTriggerBehavior EventName="TextChanged">
                        <core:InvokeCommandAction Command="{Binding SearchBoxTextChangedCommand}" />
                    </core:EventTriggerBehavior>
                    <core:EventTriggerBehavior EventName="QuerySubmitted">
                        <core:InvokeCommandAction Command="{Binding SearchBoxQuerySubmittedCommand}" />
                    </core:EventTriggerBehavior>
                </i:Interaction.Behaviors>
            </AutoSuggestBox>

            <!--Security cerificate check button-->
            <Button Background="Transparent" HorizontalAlignment="Left" Margin="15,0,0,0"
                    Padding="0" Width="28" Height="24" BorderBrush="Transparent"  Grid.Column="5"
                    VerticalAlignment="Center">
                <Button.Flyout>
                    <Flyout>
                        <Grid>
                            <TextBlock Text="Подключение защищено"></TextBlock>
                        </Grid>
                    </Flyout>
                </Button.Flyout>
                <StackPanel Orientation="Horizontal">
                    <FontIcon Glyph="&#xE72E;" Foreground="ForestGreen" FontSize="14"/>
                </StackPanel>
            </Button>

            <!--AddBookmarkButton with Flyout-->
            <Button Background="Transparent" HorizontalAlignment="Right" Margin="0,0,20,0"
                    Padding="0" Width="28" Height="24" BorderBrush="Transparent" VerticalContentAlignment="Center" Grid.Column="5"
                    VerticalAlignment="Center" Command="{Binding AddBookmarkButtonCommand}"
                    Content="{Binding AddBookmarkIcon}" 
                    ToolTipService.ToolTip="Добавить страницу в закладки" ToolTipService.Placement="Bottom">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Orientation="Vertical" Width="350">
                            <TextBlock Text="Добавить закладку" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14"
                                       Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" ></TextBlock>
                            <TextBox Text="{Binding BookmarkTitleForSave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                     Header="Заголовок" VerticalContentAlignment="Center" Margin="0,15" PlaceholderText="Название сайта"></TextBox>
                            <TextBox Text="{Binding BookmarkUrlForSave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Ссылка"
                                     VerticalContentAlignment="Center" Margin="0,10" PlaceholderText="Ссылка на сайт"></TextBox>
                            <Grid>
                                <Button Content="Отмена" HorizontalAlignment="Left" Margin="10,20,10,10" Command="{Binding CancelSaveBookmarkButtonCommand}"></Button>
                                <Button Content="Удалить" HorizontalAlignment="Center" Margin="0,20,30,10"
                                        Visibility="{Binding DeleteBookmarkButtonVisibility}" Command="{Binding DeleteBookmarkButtonCommand}"/>
                                <Button Content="Добавить" HorizontalAlignment="Right" Margin="10,20,10,10" Command="{Binding SaveBookmarkButtonCommand}"></Button>
                            </Grid>
                        </StackPanel>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <!--Search Button-->
            <Button Grid.Column="6" ToolTipService.ToolTip="Поиск" ToolTipService.Placement="Bottom"
                    Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding SearchButtonCommand}">
                <FontIcon Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}" Glyph="&#xE721;"/>
            </Button>

            <!--Bookmarks Flyout-->
            <Button Grid.Column="8" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding BookmarksButtonCommand}"
                    ToolTipService.ToolTip="Закладки" ToolTipService.Placement="Bottom">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <Grid>
                            <StackPanel Width="300">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Сохраненные закладки" FontWeight="SemiBold" FontSize="16" Margin="0,10" HorizontalAlignment="Center"
                                               Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}"/>
                                    <Button Grid.Column="1" Width="28" Height="28" Padding="0" ToolTipService.ToolTip="Параметры закладок" 
                                            Command="{Binding BookmarksSettingsButtonCommand}">
                                        <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                                    </Button>
                                </Grid>

                                <ListView MaxHeight="500" SelectionMode="Single" IsItemClickEnabled="True"
                                          ItemsSource="{Binding BookmarksList}" >
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:BookmarkDetails">
                                            <Grid Height="40">
                                                <StackPanel Orientation="Horizontal">
                                                    <BitmapIcon UriSource="{x:Bind Icon}"
                                                                ShowAsMonochrome="False" Height="20" Width="18" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{x:Bind Name}" FontSize="14" 
                                                               HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <i:Interaction.Behaviors>
                                        <core:EventTriggerBehavior EventName="ItemClick">
                                            <core:InvokeCommandAction Command="{Binding BookmarksItemClickCommand}" />
                                        </core:EventTriggerBehavior>
                                    </i:Interaction.Behaviors>
                                </ListView>
                                
                            </StackPanel>
                        </Grid>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}" Glyph="&#xE728;"/>
            </Button>
            
            <!--History Flyout-->
            <Button Grid.Column="9" Style="{StaticResource NavigationBarButtonStyle}" Command="{Binding HistoryButtonCommand}"
                    ToolTipService.ToolTip="Журнал истории" ToolTipService.Placement="Bottom">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Width="320">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="История" FontWeight="SemiBold" Margin="0,10" HorizontalAlignment="Center"
                                           FontSize="16" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}"/>
                                <Button Grid.Column="1" Width="28" Height="28" Padding="0" ToolTipService.ToolTip="Параметры журнала истории" 
                                              Command="{Binding HistorySettingsButtonCommand}">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14"/>
                                </Button>
                            </Grid>
                            <ListView MaxHeight="500" SelectionMode="Single" IsItemClickEnabled="True" 
                                      ItemsSource="{Binding HistoryList}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:HistoryItemDetails">
                                        <Grid Height="50" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="28"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Vertical" Margin="0,6,0,0">
                                                    <TextBlock Text="{Binding Name}"  FontSize="14"
                                                HorizontalAlignment="Left" FontWeight="Bold"></TextBlock>
                                                    <TextBlock Text="{Binding Url}" FontSize="11" 
                                                HorizontalAlignment="Left" />
                                                </StackPanel>
                                            <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="14" />
                                            
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <i:Interaction.Behaviors>
                                    <core:EventTriggerBehavior EventName="ItemClick">
                                        <core:InvokeCommandAction Command="{Binding HistoryItemClickCommand}" />
                                    </core:EventTriggerBehavior>
                                </i:Interaction.Behaviors>
                            </ListView>
                        </StackPanel>
                        <i:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </i:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}" Glyph="&#xF738;"/>
            </Button>


            <Rectangle Grid.Column="10"  Width="2" Fill="{Binding SecondBrush, Source={StaticResource ThemeManager}}" Margin="8"/>

            <!--Settings button-->
            <Button Grid.Column="11" Style="{StaticResource NavigationBarButtonStyle}" ToolTipService.ToolTip="Параметры" ToolTipService.Placement="Bottom">
                <FontIcon Glyph="&#xE712;"/>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Параметры" Command="{Binding SettingsButtonCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE713;"></FontIcon>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Инструменты разработчика">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xEC7A;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

        </Grid>

        <muxc:ProgressBar Height="2" IsIndeterminate="True"
                          Visibility="{Binding ProgressBarVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Foreground="{Binding  AppTitleBrush, Source={StaticResource ThemeManager}}"
                          Grid.Row="2" HorizontalAlignment="Stretch"/>

            <muxc:TabView Grid.Row="3" TabItemsSource="{Binding TabViewItemsList, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource TabViewStyleTemplate}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          SelectedItem="{Binding CurrentSelectedTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AddTabButtonCommand="{Binding AddTabButtonCommand}" 
                          Background="{Binding SecondBrush, Source={StaticResource ThemeManager}}">

                <i:Interaction.Behaviors>
                    <core:EventTriggerBehavior EventName="TabCloseRequested">
                        <core:InvokeCommandAction Command="{Binding CloseTabButtonCommand}"  />
                    </core:EventTriggerBehavior>
                </i:Interaction.Behaviors>

                <!--<muxc:TabView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewTabKeyboardAccelerator_Invoked" />
                    <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="CloseTabKeyboardAccelerator_Invoked" />
                </muxc:TabView.KeyboardAccelerators>-->
                <!--AddTabButtonClick="TabView_AddTabButtonClick" TabCloseRequested="TabView_TabCloseRequested"-->
            </muxc:TabView>
        
    </Grid>

</Page>
