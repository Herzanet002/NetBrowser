<Page
    x:Class="NetBrowser_UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls" 
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:actions="using:NetBrowser_UWP.Commands"
    d:DataContext="{d:DesignInstance Type=local:MainPage}"
    Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36px"/>
            <RowDefinition Height="36px"/>
            <RowDefinition Height="4px"/>
            <RowDefinition/>

        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}">
            <TextBlock Grid.Row="0" Text="{x:Bind AppTitleText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" VerticalAlignment="Center" Margin="15,0" 
                       Foreground="{Binding AppTitleBrush, Source={StaticResource ThemeManager}}" FontSize="14" />
            <TextBlock Grid.Row="0" Text="{StaticResource AppVersion}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,150,0" FontSize="12"
                   Foreground="{StaticResource ResourceKey=TransparentFg}"/>
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Stretch" Background="{Binding BackgroundBrush, Source={StaticResource ThemeManager}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="500*"/>
                <ColumnDefinition Width="35" />
                <ColumnDefinition Width="100*"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="35"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="10"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Style="{StaticResource NavigationBarButtonStyle}" Click="backButton_Click" ToolTipService.ToolTip="Вернутся назад" 
                    ToolTipService.Placement="Bottom">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xF0D3;" Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}"/>
            </Button>
            <Button Grid.Column="2" Click="forwardBtn_Click" Style="{StaticResource NavigationBarButtonStyle}">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xF0D2;" Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}"/>
            </Button>
            <Button Grid.Column="3" Style="{StaticResource NavigationBarButtonStyle}" Click="refreshBtn_Click" Content="{Binding RefreshButtonIcon}">
            </Button>
            <Button Grid.Column="4" Style="{StaticResource NavigationBarButtonStyle}" Click="homeBtn_Click">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE80F;" Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}"/>
            </Button>


            <!--SearchBox control-->
            <AutoSuggestBox Style="{StaticResource AutoSuggestBoxTemplate}" PlaceholderText="{StaticResource SearchBoxPlaceholderText}" Grid.Column="5"
                            Text="{Binding SearchBoxText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" TextChanged="AutoSuggestBox_TextChanged"
                            GotFocus="AutoSuggestBox_GotFocus"
                            QuerySubmitted="AutoSuggestBox_QuerySubmitted">
            </AutoSuggestBox>

            <Button Background="Transparent" HorizontalAlignment="Left" Margin="15,0,0,0"
                    Padding="0" Width="28" Height="24" BorderBrush="Transparent"  Grid.Column="5"
                    VerticalAlignment="Center" >
                <StackPanel Orientation="Horizontal">
                    <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE72E;" Foreground="ForestGreen" FontSize="14"></FontIcon>
                </StackPanel>

            </Button>
            <Button Background="Transparent" HorizontalAlignment="Right" Margin="0,0,20,0"
                    Padding="0" Width="28" Height="24" BorderBrush="Transparent" VerticalContentAlignment="Center" Grid.Column="5"
                    VerticalAlignment="Center" Click="addBookmarksBtn_Click" Content="{Binding AddBookmarkIcon}" >
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Orientation="Vertical" Width="350">
                            <TextBlock Text="Добавить закладку" Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" HorizontalAlignment="Center"></TextBlock>
                            <TextBox Text="{Binding BookmarkTitleForSave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Заголовок" VerticalContentAlignment="Center" Margin="0,15,0,0"
                         TextWrapping="NoWrap" PlaceholderText="Название сайта"></TextBox>
                            <TextBox Text="{Binding BookmarkUrlForSave, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Ссылка" VerticalContentAlignment="Center" Margin="0,10,0,0"
                         TextWrapping="NoWrap" PlaceholderText="Ссылка на сайт"></TextBox>
                            <Grid>
                                <Button Content="Отмена" HorizontalAlignment="Left" Margin="10,20,10,10" Click="CancelBookmarksBtn_Click"></Button>
                                <Button Content="Удалить" HorizontalAlignment="Center" Margin="0,20,30,10" Visibility="{Binding DeleteBookmarkButtonVisibility}" Click="DeleteBookmarkBtn_Click"/>
                                <Button Content="Добавить" HorizontalAlignment="Right" Margin="10,20,10,10" Click="SaveBookmarkBtn_Click"></Button>
                            </Grid>
                        </StackPanel>
                        <interactivity:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </interactivity:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
            </Button>

            <Button Grid.Column="6"
                    Style="{StaticResource NavigationBarButtonStyle}" Click="searchBtn_Click">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}" Glyph="&#xE721;"/>
            </Button>

            <Button Grid.Column="8" Style="{StaticResource NavigationBarButtonStyle}" Click="bookmarksBtn_Click">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <Grid>
                            <StackPanel Width="300" >
                                <TextBlock Text="Сохраненные закладки" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,15" 
                                           Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}"/>
                                <ListView Height="auto" MaxHeight="600" SelectionMode = "Single" IsItemClickEnabled = "True"
                                          ItemsSource="{Binding BookmarksList}" Background="{x:Null}" ItemClick="bookmarksFlyoutListView_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="60">
                                                <StackPanel Orientation="Horizontal">
                                                    <BitmapIcon UriSource="{Binding Icon}"
                                                ShowAsMonochrome="False" Height="20" Width="20"></BitmapIcon>
                                                    <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Bottom" FontSize="16"
                                               HorizontalAlignment="Left" Margin="10,0" FontWeight="Bold"></TextBlock>
                                                        <TextBlock Text="{Binding Url}" FontSize="12" 
                                               VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button Content="Параметры закладок"
                                        HorizontalAlignment="Center" Margin="0,15,0,0" Style="{StaticResource ButtonRevealStyle}" Click="bookmarkSettingBtn_Click" />
                            </StackPanel>
                        </Grid>
                        <interactivity:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </interactivity:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}" FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE728;"/>
            </Button>
            <Button Grid.Column="9" Style="{StaticResource NavigationBarButtonStyle}"
                    Click="historyBtn_Click">
                <Button.Flyout>
                    <Flyout Placement="Bottom">
                        <StackPanel Width="350" >
                            <TextBlock Text="История" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,15"
                                       Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}"/>
                            <ListView Height="auto" MaxHeight="600" SelectionMode = "Single" IsItemClickEnabled = "True"
                                      Background="Transparent" ItemClick="historyListView_ItemClick" ItemsSource="{Binding HistoryList}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Height="50">
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Bottom" FontSize="14"
                                               HorizontalAlignment="Left" Margin="0,0,10,0" FontWeight="Bold"></TextBlock>
                                                    <TextBlock Text="{Binding Url}" FontSize="11" 
                                               VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,10,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <Button Content="Настройка истории" Margin="0,10,0,0"
                                    HorizontalAlignment="Center" Style="{StaticResource ButtonRevealStyle}" Click="HistorySettingsButton_Click"></Button>

                        </StackPanel>
                        <interactivity:Interaction.Behaviors>
                            <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}"
                                            ComparisonCondition="Equal" Value="True">
                                <actions:CloseFlyoutAction />
                            </core:DataTriggerBehavior>
                        </interactivity:Interaction.Behaviors>
                    </Flyout>
                </Button.Flyout>
                <FontIcon Foreground="{Binding NavigationButtonBrush, Source={StaticResource ThemeManager}}" FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xF738;"/>
            </Button>

            <Rectangle Grid.Column="10"  Width="2" Fill="{Binding SecondBrush, Source={StaticResource ThemeManager}}" Margin="8"/>

            <Button Grid.Column="11" Style="{StaticResource NavigationBarButtonStyle}">
                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE700;"/>
                <Button.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem Text="Параметры" Click="settingsBtn_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon FontFamily="{StaticResource Segoe Fluent}" Glyph="&#xE713;"></FontIcon>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

        </Grid>

        <muxc:ProgressBar Height="2" IsIndeterminate="True" ShowPaused="False" ShowError="False" 
                          Visibility="{Binding ProgressBarVisibility, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Foreground="{Binding  AppTitleBrush, Source={StaticResource ThemeManager}}"
                          Grid.Row="2" HorizontalAlignment="Stretch"/>
        <Grid Grid.Row="3">
            <muxc:TabView x:FieldModifier="public" x:Name="TabsControl" Style="{StaticResource TabViewStyleTemplate}"
                          SelectedItem="{Binding CurrentSelectedTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AddTabButtonClick="tabView_AddTabButtonClick" TabCloseRequested="tabView_TabCloseRequested"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                          Background="{Binding SecondBrush, Source={StaticResource ThemeManager}}">
                <muxc:TabView.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" Invoked="NewTabKeyboardAccelerator_Invoked" />
                    <KeyboardAccelerator Key="E" Modifiers="Control" Invoked="CloseTabKeyboardAccelerator_Invoked" />
                </muxc:TabView.KeyboardAccelerators>
            </muxc:TabView>
        </Grid>
    </Grid>

</Page>
