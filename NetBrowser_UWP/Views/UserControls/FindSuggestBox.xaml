<UserControl
    x:Class="NetBrowser_UWP.Views.UserControls.FindSuggestBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:NetBrowser_UWP.Helpers"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:core="using:Microsoft.Xaml.Interactions.Core"
    xmlns:commands="using:NetBrowser_UWP.Commands"
    xmlns:converters="using:NetBrowser_UWP.Converters"
    xmlns:models="using:NetBrowser_UWP.Models"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:animatedVisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:tools="using:Microsoft.Toolkit.Uwp.UI.Converters"
    xmlns:vm="using:NetBrowser_UWP.ViewModels.Controls"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=vm:FindBoxViewModel, IsDesignTimeCreatable=True}"
    d:DesignHeight="100"
    d:DesignWidth="400">
    <UserControl.Resources>
        <converters:InvertBooleanConverter x:Key="InvertBooleanConverter" />
        <converters:SearchTermItemConverter x:Key="SearchTermItemConverter"/>
        <tools:BoolToObjectConverter
            x:Key="SearchSuggestionGlyphConverter"
            FalseValue="&#xF738;"
            TrueValue="&#xF6FA;" />

        <Style x:Key="TextBoxStyle"
               BasedOn="{StaticResource AutoSuggestBoxTextBoxStyle}"
               TargetType="TextBox">
            <Setter Property="MinWidth" Value="{ThemeResource TextControlThemeMinWidth}" />
            <Setter Property="MinHeight" Value="{ThemeResource TextControlThemeMinHeight}" />
            <Setter Property="Padding" Value="{StaticResource FindSuggestBoxTextBoxPadding}" />
            <Setter Property="Foreground" Value="{ThemeResource TextControlForeground}" />
            <Setter Property="BorderBrush" Value="{ThemeResource SystemBaseMediumLowColor}" />
            <Setter Property="BorderThickness" Value="{ThemeResource TextControlBorderThemeThickness}" />
            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}" />
            <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}" />
            <Setter Property="Background" Value="{ThemeResource TextControlBackground}" />
            <Setter Property="SelectionHighlightColor" Value="{ThemeResource TextControlSelectionHighlightColor}" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollMode" Value="Auto" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        </Style>

        <DataTemplate x:Key="SuggestionTemplate" x:DataType="models:SearchTermItem">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon HorizontalAlignment="Left"
                          Glyph="{x:Bind IsNewSuggestedSearchQuery, Converter={StaticResource SearchSuggestionGlyphConverter}}"
                          FontSize="14"
                          Foreground="{Binding Path =NavigationButtonBrush, Source={StaticResource ThemeManager}}" />
                <StackPanel Orientation="Vertical" 
                            Margin="10,0,0,0">
                    <TextBlock Text="{Binding Converter={StaticResource SearchTermItemConverter}}" />
                </StackPanel>

            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <AutoSuggestBox x:Name="SearchBox"
                        Height="34"
                        CornerRadius="7"
                        HorizontalAlignment="Stretch"
                        TextBoxStyle="{StaticResource TextBoxStyle}"
                        ItemTemplate="{StaticResource SuggestionTemplate}"
                        BorderBrush="{ThemeResource ControlElevationBorderBrush}"
                        Text="{Binding QueryText, Mode=TwoWay}"
                        ItemsSource="{Binding SuggestionsCollection}"
                        PlaceholderText="{helpers:ResourceString Name=SearchBoxPlaceholder/PlaceholderText}">
            <AutoSuggestBox.Shadow>
                <ThemeShadow />
            </AutoSuggestBox.Shadow>

            <AutoSuggestBox.QueryIcon>
                <controls:AnimatedIcon Height="16">
                    <controls:AnimatedIcon.Source>
                        <animatedVisuals:AnimatedFindVisualSource />
                    </controls:AnimatedIcon.Source>
                    <controls:AnimatedIcon.FallbackIconSource>
                        <controls:SymbolIconSource Symbol="Find" />
                    </controls:AnimatedIcon.FallbackIconSource>
                </controls:AnimatedIcon>
            </AutoSuggestBox.QueryIcon>

            <interactivity:Interaction.Behaviors>
                <core:EventTriggerBehavior EventName="TextChanged">
                    <core:InvokeCommandAction Command="{Binding QueryTextChangedCommand}" />
                </core:EventTriggerBehavior>
                <core:EventTriggerBehavior EventName="QuerySubmitted">
                    <core:InvokeCommandAction Command="{Binding QuerySubmittedCommand}" />
                </core:EventTriggerBehavior>
            </interactivity:Interaction.Behaviors>
        </AutoSuggestBox>

        <Button Background="Transparent" HorizontalAlignment="Left" Margin="5,0,0,0"
                Padding="0" Width="28" Height="24" BorderBrush="Transparent"
                VerticalAlignment="Center" Command="{Binding AddBookmarkButtonCommand}"
                ToolTipService.ToolTip="{helpers:ResourceString Name=SaveBookmarkButton/Tooltip}"
                ToolTipService.Placement="Bottom">
            <interactivity:Interaction.Behaviors>
                <core:DataTriggerBehavior Binding="{Binding IsBookmarksExists}" Value="True">
                    <core:DataTriggerBehavior.Actions>
                        <core:ChangePropertyAction
                            PropertyName="Content">
                            <core:ChangePropertyAction.Value>
                                <FontIcon Glyph="&#xE735;" FontSize="14"
                                          Foreground="{Binding BookmarkSavedBrush, Source={StaticResource ThemeManager}}" />
                            </core:ChangePropertyAction.Value>
                        </core:ChangePropertyAction>
                    </core:DataTriggerBehavior.Actions>
                </core:DataTriggerBehavior>
                <core:DataTriggerBehavior Binding="{Binding IsBookmarksExists}" Value="False">
                    <core:DataTriggerBehavior.Actions>
                        <core:ChangePropertyAction
                            PropertyName="Content">
                            <core:ChangePropertyAction.Value>
                                <FontIcon Glyph="&#xE734;" FontSize="14" />
                            </core:ChangePropertyAction.Value>
                        </core:ChangePropertyAction>
                    </core:DataTriggerBehavior.Actions>
                </core:DataTriggerBehavior>
            </interactivity:Interaction.Behaviors>
            <Button.Flyout>
                <Flyout Placement="Bottom">
                    <StackPanel Width="300" Margin="5">
                        <TextBlock Text="{helpers:ResourceString Name=AddToBookmarks}" HorizontalAlignment="Center" FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}" />
                        <TextBox Text="{Binding BookmarkTitleForSave, Mode=TwoWay}"
                                 Header="{helpers:ResourceString Name=Header}" Margin="0,15" PlaceholderText="{helpers:ResourceString Name=SiteName}" />
                        <TextBox Text="{Binding BookmarkUrlForSave, Mode=TwoWay}" Header="{helpers:ResourceString Name=Link}"
                                 Margin="0,10,0,30" PlaceholderText="{helpers:ResourceString Name=LinkOnASite}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="{helpers:ResourceString Name=Cancel}"
                                    Command="{Binding CancelSaveBookmarkButtonCommand}" />
                            <Button Content="{helpers:ResourceString Name=Remove}" Grid.Column="1" HorizontalAlignment="Right"
                                    Visibility="{Binding DeleteBookmarkButtonVisibility}"
                                    Command="{Binding DeleteBookmarkButtonCommand}" />
                            <Button Grid.Column="1" Content="{helpers:ResourceString Name=Add}"
                                    Command="{Binding SaveBookmarkButtonCommand}" HorizontalAlignment="Right"
                                    Visibility="{Binding DeleteBookmarkButtonVisibility, Converter={StaticResource InvertBooleanConverter}}" />
                        </Grid>
                    </StackPanel>
                    <interactivity:Interaction.Behaviors>
                        <core:DataTriggerBehavior Binding="{Binding IsFlyoutClosed}" ComparisonCondition="Equal"
                                                  Value="True">
                            <commands:CloseFlyoutAction />
                        </core:DataTriggerBehavior>
                    </interactivity:Interaction.Behaviors>
                </Flyout>
            </Button.Flyout>
        </Button>
    </Grid>
</UserControl>