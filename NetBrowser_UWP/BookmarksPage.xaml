<Page
    x:Class="NetBrowser_UWP.BookmarksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance Type=local:BookmarksPage}"
    Loaded="bookmarksPage_Loaded">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" Text="Закладки" FontSize="40" Grid.Row="0"
                   Foreground="{Binding ForegroundBrush, Source={StaticResource ThemeManager}}"
                   Margin="50,30,0,20"/>

        <Grid Grid.Row="1" Margin="50,0,0,0">
            <ListView Background="{x:Null}" x:Name="BookmarksListView" ItemsSource="{Binding BookmarksList,
                UpdateSourceTrigger=PropertyChanged}" FlyoutBase.AttachedFlyout="{x:Bind BookmarkMenuFlyout}"
                  IsItemClickEnabled="True" SelectionMode="Single" IsTapEnabled="True" Tapped="BookmarksListView_Tapped"  >
                <ListView.Resources>
                    <MenuFlyout x:Name="BookmarkMenuFlyout" Placement="Bottom">
                        <MenuFlyout.Items>
                            <MenuFlyoutItem Text="Открыть закладку" Click="Open_Click"   >
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE774;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Редактировать" Click="Edit_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xEB7E;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Удалить" Click="Remove_Click"  >
                                <MenuFlyoutItem.Icon>
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D9;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>

                        </MenuFlyout.Items>
                    </MenuFlyout>
                </ListView.Resources>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="60">
                            <StackPanel Orientation="Horizontal">
                                <BitmapIcon UriSource="{Binding Icon}"
                                                ShowAsMonochrome="False" Height="20" Width="20"></BitmapIcon>
                                <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Bottom" FontSize="16"
                                               HorizontalAlignment="Left" Margin="10,0" FontWeight="Bold"
                                               Foreground="{Binding ForegroundBrush, 
                                        Source={StaticResource ThemeManager}}"></TextBlock>

                                    <TextBlock Text="{Binding Url}" FontSize="12" 
                                               VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,0" 
                                               Foreground="{Binding ForegroundBrush, 
                                        Source={StaticResource ThemeManager}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <ContentDialog x:Name="editingBookmarkDialog" VerticalAlignment="Stretch"
                       Title="Редактирование закладки"
                       PrimaryButtonText="OK" Grid.Row="1"
                       SecondaryButtonText="Отмена" IsPrimaryButtonEnabled="True">

            <StackPanel >
                <TextBox Header="Заголовок" VerticalContentAlignment="Center" Margin="0,10,0,0"
                         TextWrapping="NoWrap" PlaceholderText="Название сайта"
                         Text="{Binding BookmarkNewTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                <TextBox Header="Ссылка" VerticalContentAlignment="Center" Margin="0,10,0,0"
                         TextWrapping="NoWrap" Text="{Binding BookmarkNewUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         PlaceholderText="Ссылка на сайт"></TextBox>

            </StackPanel>

        </ContentDialog>

    </Grid>


</Page>
