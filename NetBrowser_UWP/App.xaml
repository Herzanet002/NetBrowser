<Application
    x:Class="NetBrowser_UWP.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetBrowser_UWP" 
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Application.Resources>

        <ResourceDictionary>
            
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <ResourceDictionary Source="Styles/TabViewItem_Style.xaml"></ResourceDictionary>
                <ResourceDictionary Source="Styles/TabViewTemplate_Style.xaml"></ResourceDictionary>
                <ResourceDictionary Source="Styles/AutoSuggestBox_Style.xaml"></ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
            <local:ThemeManager x:Key="ThemeManager" />
            <SolidColorBrush x:Key="ErrorBg" Color="#FF381E1E"/>
            <SolidColorBrush x:Key="TransparentFg" Color="#4CFFFFFF"/>
            <SolidColorBrush x:Key="SearchBoxBg" Color="#FF282828"></SolidColorBrush>
            <SolidColorBrush x:Key="SearchBoxFocusedBrush" Color="#FF63ADE5"></SolidColorBrush>
            <SolidColorBrush x:Key="BookmarkAdded" Color="#FF3F85B9"></SolidColorBrush>
            <x:String x:Key="AppVersion" >ver.0.3.01</x:String>
            <x:String x:Key="AppName" >NetBrowser</x:String>
            <x:String x:Key="SearchBoxPlaceholderText" >Поиск...</x:String>
            <x:String x:Key="SuggestBoxSearchText" >Искать в интернете </x:String>
            <FontFamily x:Key="Segoe Fluent">pack://application:,,,/Fonts/#Segoe Fluent Icons</FontFamily>
            <FontFamily x:Key="Segoe Variable">pack://application:,,,/Fonts/#Segoe Variable</FontFamily>
            <!-- ReSharper disable once Xaml.StaticResourceNotResolved -->
            <Style x:Name="NavigationBarButtonStyle" BasedOn="{StaticResource ButtonRevealStyle}" TargetType="Button">
                <Setter Property="Background" Value="Transparent"></Setter>
                <Setter Property="HorizontalAlignment" Value="Center"></Setter>
                <Setter Property="Padding" Value="0"></Setter>
                <Setter Property="Width" Value="30"></Setter>
                <Setter Property="Height" Value="30"></Setter>
                <Setter Property="BorderThickness" Value="1"></Setter>

            </Style>
            
           
            <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}" x:Key="ContentDialogStyle"></Style>








        </ResourceDictionary>


    </Application.Resources>

</Application>
